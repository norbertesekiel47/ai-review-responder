{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": [
    "react-dom",
    "postcss-load-config",
    "eslint-config-next",
    // CLI tool, invoked via the `doctor` script / React Doctor Action, never imported.
    "react-doctor"
  ],
  "entry": [
    "scripts/clear-signup-rate-limits.ts",
    "scripts/zernio-backfill-external-replies.ts",
    "scripts/posthog-backfill-activations.ts"
  ],
  "ignoreExports": [
    {
      "file": "worker/background/pollers/CleanupAbandonedSignupsPoller.ts",
      "exports": ["runOnce"]
    },
    {
      "file": "worker/background/pollers/EmailChannelReconcilePoller.ts",
      "exports": ["runOnce"]
    },
    {
      "file": "worker/background/pollers/StripeLocationsReconcilePoller.ts",
      "exports": ["runOnce"]
    },
    {
      "file": "worker/background/pollers/ZernioRecentReviewPoller.ts",
      "exports": ["runOnce"]
    },
    // Owner-offboarding feature: deliberately-retained API surface with no current
    // cross-file consumer. clearFreshAuthCookie is the symmetric clear for the
    // destructive-auth fresh-auth cookie (kept beside its setter); the analytics
    // allowlist + terminal-status union are referenced via type/runtime gates the
    // analyzer cannot trace. Acknowledged rather than deleted.
    {
      "file": "src/lib/account-offboarding/destructive-auth.ts",
      "exports": ["clearFreshAuthCookie"]
    },
    {
      "file": "src/lib/analytics/events.ts",
      "exports": ["CLIENT_ENQUEUEABLE_EVENT_NAMES"]
    },
    {
      "file": "src/lib/account-offboarding/types.ts",
      "exports": ["AccountOffboardingTerminalStatus"]
    },
    // resolveContactNotifyTo has no production consumer — notifyContactSubmission
    // (the 3-route public API) calls it INTERNALLY (same-module, not an export
    // consumer fallow traces), and it is exercised directly by
    // contact-notify.test.ts via dynamic import (set->resetModules->import, the
    // Stage-3 config-migration test pattern), which the static analyzer can't link.
    // It is a deliberately-retained, directly-tested internal — acknowledged.
    {
      "file": "src/lib/notifications/contact-notify.ts",
      "exports": ["resolveContactNotifyTo"]
    },
    // Test-only seams of the Stripe client singleton, surfaced when the Stage-3
    // Stripe config batch touched this file (fallow's new-only gate only scans
    // changed files; these were unflagged before only because the file was
    // unchanged). STRIPE_CLIENT_CONFIG is the pinned apiVersion/timeout/retry
    // contract asserted by stripe-client.test.ts (the model/pinning guard);
    // resetStripeClientForTests clears the singleton for per-case env stubbing.
    // fallow excludes test files as consumers, so both read as unused exports —
    // they are intentional test seams, acknowledged here the same way runOnce is.
    {
      "file": "src/lib/payments/stripe-client.ts",
      "exports": ["STRIPE_CLIENT_CONFIG", "resetStripeClientForTests"]
    },
    // signFeedback IS used — by worker/jobs/WeeklySummaryWorker.ts,
    // worker/ingress/zernio/zernio-verify.ts, and src/app/api/feedback/route.ts.
    // The Stage-3 src-lib config batch touched feedback-hmac.ts (CSRF_SECRET now
    // read via getServerConfig()), bringing it into fallow's new-only changed-file
    // scope; those consumer files are NOT in the changed set, so the incremental
    // scan can't link them and reads the export as unused. False positive,
    // acknowledged the same way the Stripe test-seam exports are.
    {
      "file": "src/lib/shared/feedback-hmac.ts",
      "exports": ["signFeedback"]
    },
    // ReviewStatus is the derived union type paired with REVIEW_STATUS (the
    // reviews.status vocabulary's single owner). No current call site needs the
    // TYPE — only the runtime values (reviews-status-audit.ts imports
    // REVIEW_STATUS itself, not ReviewStatus) — but the module previously read
    // as an entirely unused FILE, masking this per-export finding; wiring
    // reviews-status-audit.ts's import onto REVIEW_STATUS (quality-review fix
    // round) made the file reachable and surfaced it. Kept as the module's
    // public contract for a future typed call site (e.g. a function parameter
    // typed `status: ReviewStatus`), not deleted.
    {
      "file": "src/lib/reviews/status.ts",
      "exports": ["ReviewStatus"]
    }
  ],
  // NotificationChannel send methods are invoked via interface dispatch through the
  // getChannel(id) factory, so fallow's syntactic analysis can't link the concrete class
  // methods (EmailChannel/TelegramChannel/WhatsAppChannel) to their call sites. Allowlist
  // them on the interface so the dispatched methods aren't reported as unused.
  "usedClassMembers": [
    { "implements": "NotificationChannel", "members": ["sendApprovalRequest", "sendAutoPostNotice"] }
  ],
  "health": {
    "ignore": [
      "**/dist/**",
      "**/__generated__/**",

      // Tests are intentionally DAMP and often have large setup callbacks.
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",

      // Existing orchestration handlers touched mechanically by the
      // auto-approval lane/outbox threading. Splitting these is separate
      // refactor work; the new auto-approval predicate itself remains covered
      // by health after being extracted into small decision helpers.
      "src/app/api/dashboard/past-replies/draft/route.ts",
      "src/app/api/dashboard/past-replies/publish/route.ts",
      "src/app/api/dashboard/past-replies/*/retry/route.ts",
      "src/app/api/dashboard/past-replies/*/restore-original/route.ts",
      "src/lib/reviews/process-review.ts",
      "worker/jobs/publisher/ResponsePublisherWorker.ts",
      "worker/jobs/zernio/ZernioBackfillWorker.ts",

      // Existing large handlers touched mechanically by the response-status
      // single-sourcing (audit Stage 1 src-side): one READ predicate migrated to
      // statusArraySql(), or one inline write-guard literal pragma'd, each landing
      // inside a pre-existing >60-line function. The complexity is pre-existing on
      // main; splitting these is separate refactor work.
      "src/lib/dashboard/aggregate-service.ts",
      "src/app/api/dashboard/past-replies/draft-status/route.ts",
      "src/lib/publishing/zernio-publisher.ts",
      "src/lib/approval/http-routes.ts",

      // ── Owner-offboarding feature (acknowledged orchestration) ──
      // New offboarding orchestration handlers/components + workers, plus existing
      // route/component handlers the gate-wiring touched mechanically (the single
      // shared guard `gate.ts` is threaded into every owner write / connect / billing
      // surface). These are entry-point orchestration (validate → call one module →
      // return) or staged provider workflows; splitting them further would add
      // pass-through indirection the design rules reject. The deep logic lives in
      // extracted modules (snapshot, confirm, teardown-*, purge-stages, gate, the
      // writable/destructive-auth gates). Acknowledged as separate refactor work; the
      // critical correctness paths (purge, reactivation, teardown) are test-covered.
      "src/app/api/account/offboarding/confirm/route.ts",
      "src/app/api/account/offboarding/retry-billing/route.ts",
      "src/app/admin/offboardings/OffboardingsClient.tsx",
      "src/app/api/admin/offboardings/*/provider-disposition/route.ts",
      "src/components/dashboard/settings/DeleteDataOffboardingModal.tsx",
      "src/components/dashboard/DashboardContent.tsx",
      "src/app/(authenticated)/account/offboarding/status/OffboardingStatusClient.tsx",
      "src/lib/account-offboarding/provider-disposition.ts",
      "src/lib/account-offboarding/purge-verification.ts",
      "src/lib/account-offboarding/reactivate.ts",
      "src/lib/account-offboarding/keep-my-data.ts",
      "src/lib/account-offboarding/destructive-auth.ts",
      "src/lib/account-offboarding/stripe-invoices.ts",
      "worker/jobs/account-offboarding/AccountOffboardingEmailWorker.ts",
      "worker/jobs/account-offboarding/purge-stages.ts",
      "worker/jobs/account-offboarding/teardown-stripe.ts",
      "worker/index.ts",
      "worker/ingress/zernio/zernio.ts",
      // Existing handlers touched mechanically by gate-wiring (already complex on
      // main; the offboarding PR only threaded the guard call through them).
      "src/proxy.ts",
      "src/app/api/billing/checkout/route.ts",
      "src/app/api/billing/portal/route.ts",
      "src/app/api/billing/tier-change/route.ts",
      "src/app/api/zernio/connect/start/route.ts",
      "src/app/api/zernio/connect/cancel/route.ts",
      "src/app/api/zernio/connect/callback/route.ts",
      "src/app/api/zernio/connect/_shared/finalize/authorize.ts",
      "src/app/api/zernio/connect/_shared/finalize/finalize-tx.ts",
      "src/app/api/zernio/disconnect/route.ts",
      "src/app/api/auth/mfa/challenge/route.ts",
      "src/app/api/admin/impersonation/start/route.ts",
      "src/app/api/admin/businesses/*/zernio-queue/route.ts",
      "src/components/admin/AdminNav.tsx",
      "src/hooks/useAccountData.ts",
      "src/lib/admin/business-detail/mappers.ts",
      "worker/ingress/telegram/telegram-shared.ts",
      "scripts/ci/tenant-scope-audit.ts",
      "scripts/ci/static-policy-audit.ts",
      // Authenticated layout: the offboarding status banner / gate-aware screens
      // were threaded in mechanically.
      "src/app/(authenticated)/layout.tsx",
      // Past Replies data loader: loadPastRepliesPageView is entry-level data
      // orchestration — 5 tenant-scoped SQL queries via Promise.all, low cognitive
      // complexity (7). The C-2 gating / bucketing / row mapping were EXTRACTED into
      // the pure, unit-tested replies-view.ts; the residual length is inherent SQL,
      // and splitting per-query would add the pass-through indirection design.md
      // rejects (invariant #12). Replaces the old dashboard/past-replies/page.tsx
      // entry, which moved to reviews/history/page.tsx and is now a 58-line shell.
      "src/lib/past-replies/load-replies.ts",

      // ── Multi-location duplicate-place_id hardening (PR C, touched mechanically) ──
      // addLocationTransaction is a large single-tx orchestration (businesses INSERT +
      // audit + overage outbox + URL-mode validate_place_id enqueue) that PR C wrapped
      // in a try/catch to map the 23505 → 'duplicate_location'; the complexity is
      // inherent to the one-transaction flow, not the wrap. The CSV import route +
      // parser (importLocationsCsv, parseCsv, parseCsvRecords, processRow) were already
      // complex on main — CSV tokenisation is inherently branchy; PR C only added the
      // in-file dedup wiring + per-row duplicate reason. Acknowledged as pre-existing;
      // deferred cleanup: extract the shared CSV parser (see duplicates ack below).
      // csv-import route: the import-POLICY loop moved into
      // csv-import.importCsvRows; what remains in importLocationsCsv is
      // multipart/step orchestration (auth, size/row gates, audit, billing
      // enqueue, response mapping) that was already 15-cyclomatic on main —
      // entry points orchestrate (invariant #12). Pre-existing, not grown.
      "src/app/api/admin/locations/csv-import/route.ts",
      "src/lib/locations/add-location-tx.ts",
      "src/lib/admin/csv-import.ts",
      // ── Pre-existing complexity swept in by PR C's mechanical touches ──
      // PR C's edits to these files were small (6-line enqueueValidatePlaceId
      // swaps in the two onboarding routes; duplicate_location error-copy
      // mapping in the panel/wizard). The flagged functions (onboarding POST
      // handlers, LocationRow/locationRowReducer, wizard fetchers) predate the
      // PR and were not grown by it; refactoring live onboarding/UI flows
      // pre-launch is unjustified risk. Cleanup candidates post-launch.
      "src/app/api/onboarding/start/route.ts",
      "src/app/api/onboarding/business/route.ts",
      "src/lib/onboarding/create-business.ts",
      "src/components/dashboard/settings/LocationsPanel.tsx",
      "src/app/(authenticated)/dashboard/add-location/wizard/useAddLocationWizard.ts",

      // ── Multi-location billing-recovery hardening (PR D, touched mechanically) ──
      // Pre-existing large worker functions PR D extended with small, spec-mandated
      // edits — not structural growth. reconcileAccount: a behavior-preserving
      // findOverageItem call-site swap (the local heuristic was deleted, logic moved
      // to the shared src/lib/payments/overage-item.ts). handleUpdateStripeOverage:
      // one transient/terminal catch branch; the classification logic itself is
      // extracted into stripe-overage-error.classifyStripeOverageError, so what
      // remains is the inherent gates→Stripe-calls→outbox orchestration.
      // processCheckoutSessionCompleted: one outbox INSERT added inside the existing
      // rowcount-guarded activation block — zero new branches. These are entry-point
      // orchestration (invariant #12) whose complexity is inherent to the one-pass
      // flow; splitting them is separate refactor work, unjustified risk pre-launch.
      // Cleanup candidates post-launch.
      "worker/background/pollers/billing-reconciliation/reconcile-account.ts",
      "worker/jobs/billing/UpdateStripeOverageWorker.ts",
      "worker/ingress/stripe/checkout-completed.ts",

      // ── Pre-existing complexity swept in by PR E's mechanical touches ──
      // PR E (digest toggles → accounts + channel-module consolidation) touched
      // these files without growing the flagged functions. The owner telegram/
      // whatsapp start handlers (13/12-cyclomatic) and the telegram cancel
      // handler predate the branch — PR E only swapped the per-channel
      // enrollment imports for the parameterized mobile-enrollment module.
      // getActiveDashboardData (188 lines) only changed its digest-toggle read
      // to JOIN accounts; the runbook page change is a one-line copy edit.
      // Refactoring live enrollment/dashboard flows for an import swap is
      // unjustified risk pre-launch; cleanup candidates post-launch. (The two
      // summary schedulers carry their own in-file fallow-ignore suppressions —
      // not duplicated here.)
      "src/app/api/dashboard/channels/telegram/start/route.ts",
      "src/app/api/dashboard/channels/whatsapp/start/route.ts",
      "src/app/api/dashboard/channels/telegram/cancel/route.ts",
      "src/lib/dashboard/service.ts",
      "src/app/admin/runbook/page.tsx",

      // ── Multi-location E2E verification kit (PR F) ──
      // ONLY the two DAMP infrastructure files, named explicitly — no blanket
      // e2e/** (which would pre-suppress every future e2e file unseen). Specs
      // and __tests__ are already covered by the global ignores. The seeder is
      // a multi-table single-tx INSERT module; the fixture server is a
      // per-endpoint HTTP request router — both intentionally DAMP.
      // (src/lib/zernio/client/transport.ts carries finding-level
      // fallow-ignore-next-line suppressions in-file instead of a whole-file
      // entry here, so future complexity growth in that production file is
      // NOT masked.)
      "e2e/seed.ts",
      "e2e/fixtures/zernio-fixture-server.ts",

      // ── Settings IA optimization (sidebar nav + Brand Voice/Profile/Billing
      //    routes; offboarding split by category) ──
      // NEW components that are faithful splits/relocations of code already
      // acknowledged on main: CancelSubscriptionPanel + DeleteDataPanel are the
      // two halves of the (previously-acknowledged) AccountOffboardingPanel,
      // BillingPanel is the subscription/tier-change section relocated VERBATIM
      // from the (previously-acknowledged) AccountPanel, and ProfilePanel is the
      // locked-field markup lifted from GeneralPanel. The split REDUCED per-file
      // size vs the ~340-line combined panel; the residual length is
      // presentational JSX (TierChangeModal) + the inherent one-active-mode
      // offboarding state machine. useOffboardingStatus.load is a 15-line fetch
      // whose cyclomatic count is `??` fallback chains, not real branches.
      // Acknowledged as separate refactor work; cleanup candidates post-launch.
      "src/components/dashboard/settings/CancelSubscriptionPanel.tsx",
      "src/components/dashboard/settings/DeleteDataPanel.tsx",
      "src/components/dashboard/settings/BillingPanel.tsx",
      "src/components/dashboard/settings/ProfilePanel.tsx",
      "src/hooks/useOffboardingStatus.ts",
      // Pre-existing complexity swept into changed-file scope by this PR's
      // mechanical touches — the flagged functions predate the branch and were
      // NOT grown by it: AutoApprovalClient (208) / ChannelsTabClient (170) /
      // VoiceClient (82) / channels page (85) only had the dead SettingsShell
      // tab-props removed; locations page (111) only had voiceHref + the two
      // stale-anchor ctaHrefs repointed; the account/settings GET (80) was a
      // comment-only edit. Refactoring these live flows for a prop/anchor/comment
      // change is unjustified risk; cleanup candidates post-launch.
      "src/app/(authenticated)/settings/auto-approval/AutoApprovalClient.tsx",
      "src/app/(authenticated)/settings/channels/ChannelsTabClient.tsx",
      "src/app/(authenticated)/settings/channels/page.tsx",
      "src/app/(authenticated)/settings/locations/page.tsx",
      "src/app/(authenticated)/settings/voice/VoiceClient.tsx",
      "src/app/api/account/settings/route.ts",

      // ── Admin console redesign Phase 3 (relocations + mechanical palette/formatter touches) ──
      // Phase 3 made every admin page server-first: the old client `page.tsx`
      // bodies moved VERBATIM into sibling `*Client.tsx` files while the page
      // became a ~30-line RSC shell, and the console palette sweep (indigo/blue →
      // the neutral console greys) plus the shared `formatAdminDateTime` import
      // touched many pre-existing files. fallow's `--gate new-only` scopes by
      // changed FILE, not changed FUNCTION, so both classes pull long-standing
      // findings into scope for the first time. Verified against `origin/main`
      // with a coverage-informed `fallow health` baseline — each entry below
      // records main's numbers so a reviewer can confirm nothing grew. Same
      // precedent as the "Settings IA optimization" block above.
      //
      // NOT suppressed, fixed instead: `GET /api/admin/businesses` (0% tested →
      // 18 new handler tests) and `useBusinessDetail.clearBounceFlag` (0% tested
      // → 7 new jsdom tests). Both drop off the report on merit.
      //
      // (a) FAITHFUL RELOCATIONS — new filename, pre-existing body.
      // Glob note: the `[id]`/`[sessionId]` segments are spelled `*` because a
      // literal `[id]` is a glob character class, matching one of 'i'/'d'.
      //
      // BusinessDetailClient.tsx ← src/app/admin/businesses/[id]/page.tsx, which
      // was 300 lines on main with `BusinessDetailPage` at 269 lines / 15
      // cyclomatic / 240 CRAP (fallow-CRITICAL on main). The relocated component
      // is 266 lines / 18 cyclomatic. The +3 cyclomatic is honest and named: the
      // single `if (isLoading)` / `if (isError || !data)` pair became
      // `if (isLoading && !data)` / `if (isError && !data)` / `if (!data)` plus a
      // non-blocking `{isError && <ErrorState/>}` banner — the spec §4 rule that
      // a page holding server-rendered data must never blank itself on a
      // background refetch failure. That is 4 short guards in a presentational
      // component that was already over every threshold on main; extracting them
      // would not move the finding.
      "src/app/admin/businesses/*/BusinessDetailClient.tsx",
      // NewBusinessClient.tsx ← src/app/admin/businesses/new/page.tsx (152 lines
      // on main; git scores the move at 63% similarity). Flagged `onSubmit` is
      // unchanged: 9 cyclomatic / 8 cognitive / 52 lines / 90 CRAP on BOTH sides.
      "src/app/admin/businesses/new/NewBusinessClient.tsx",
      // DemosClient.tsx ← src/app/admin/demos/page.tsx (276 lines on main; git
      // scores the move at 65% similarity). Flagged `mutationFn` is unchanged:
      // 6 cyclomatic / 5 cognitive / 24 lines / 42 CRAP on BOTH sides.
      "src/app/admin/demos/DemosClient.tsx",
      //
      // (b) PRE-EXISTING FILES, MECHANICAL TOUCH ONLY — the exact edit is named
      // per file; in every case the flagged function's metrics are identical to
      // main (or lower), so nothing here is masking growth.
      //
      // ProfileEditor.tsx — `bg-indigo-600` → `bg-gray-900` on the save button
      // and the two date cells switched to `formatAdminDateTime`. Its
      // `ProfileEditor` went 10 → 9 cyclomatic (287 lines both sides) and
      // `mutationFn` is identical at 8/7/42, 72 CRAP.
      "src/app/admin/businesses/*/_components/ProfileEditor.tsx",
      // ManualRankingSection.tsx — palette swap only (indigo → gray on the
      // submit button + table chrome); 203 lines on both sides. `reducer`
      // (8/1/18, 72 CRAP) and `submit` (7/7/28, 56 CRAP) are byte-identical to
      // main.
      "src/app/admin/businesses/*/_components/ManualRankingSection.tsx",
      // TrackedKeywordsSection.tsx — palette swap only; 107 lines on both sides.
      // `save` is identical at 5/5/21, 30 CRAP.
      "src/app/admin/businesses/*/_components/TrackedKeywordsSection.tsx",
      // ReviewsList.tsx — one `formatAdminDateTime` import replacing an inline
      // `toLocaleDateString` (+1 line net). The flagged row-render arrow is
      // identical at 6/5/38, 42 CRAP.
      "src/app/admin/businesses/*/_components/ReviewsList.tsx",
      // ZernioConnectionPanel.tsx — palette swap only (489 → 488 lines).
      // `handleDisconnect` is identical at 6/6/28, 42 CRAP (main :369, here
      // :368). NOTE: this file was already listed under `duplicates.ignore`
      // below; that block does NOT suppress complexity, which is why the health
      // entry is needed here too.
      "src/app/admin/businesses/*/_components/ZernioConnectionPanel.tsx",
      // BusinessInfoSection.tsx — a single `_shared` import line changed. The
      // flagged `BusinessInfoSection` is identical at 12/6/121, 156 CRAP.
      "src/app/admin/businesses/new/_components/BusinessInfoSection.tsx",
      // csv-import/CsvImportClient.tsx — palette swap + `formatAdminDateTime`
      // (357 → 346 lines). `parseCsvRecords` (15/25/51, 63.6 CRAP) and
      // `handleSubmit` (12/11/59, 43.1 CRAP) are identical to main; the CSV
      // tokeniser's inherent branchiness is already acknowledged for this file
      // in the PR-C block above and under `duplicates.ignore` below — the latter
      // is dupes-scoped only and never covered complexity.
      "src/app/admin/locations/csv-import/CsvImportClient.tsx",
      // impersonate/[sessionId]/view/page.tsx — this one IMPROVED: the locations
      // table was extracted into ImpersonationLocationsTable.tsx, taking
      // `AdminImpersonationViewPage` from 12 cyclomatic / 141 lines / 156 CRAP on
      // main down to 11 / 104 / 132. Still over threshold, so it is acknowledged
      // rather than left to fail a gate it was already failing before the PR.
      "src/app/admin/impersonate/*/view/page.tsx"
    ]
  },
  "duplicates": {
    "ignoreImports": true,
    // Surface all repeated clones (2+ sites) so a new copy-paste pair stays
    // visible to anyone running `fallow dupes` locally. Intentional/divergent
    // clones are acknowledged by name in the `ignore` list below, not hidden by
    // a blanket occurrence threshold.
    "minOccurrences": 2,
    "ignore": [
      // Tests/e2e are intentionally DAMP; Next.js page.tsx are layout/auth-redirect
      // boilerplate; CI scripts are audit scaffolds. Dupes-scoped only — the
      // dead-code analyzer still sees all of these.
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "e2e/**",
      "**/*.stories.tsx",
      "src/app/**/page.tsx",
      "scripts/ci/**",

      // ── Reviewed, intentional/divergent duplication (acknowledged) ──
      // The clones below are either deliberately parallel, behaviourally
      // divergent, or extractable only by adding tiny pass-through helpers that
      // the project's design rules reject (design.md / repworth.md "add nothing").
      // They are acknowledged here instead of force-merged. The genuinely-deep
      // shared concern — the role-auth gate family — was EXTRACTED, not frozen:
      // requireRoleOr401 (all admin/owner/channel routes), requireAdminWithAal2
      // (admin control-plane MFA gate), requireOwnerWithAccount/requireWritableOwner
      // (owner + account), so admin control-plane and billing no longer appear here.

      // Admin SMS channel routes: the deep logic already lives in _shared
      // (loadBusinessAccountContext, withMobileEnrollmentLock, subscription
      // guards). The residual is per-action composition glue around a GET-query
      // vs POST-body business_id parse — extracting it would be a thin wrapper.
      "src/app/api/admin/channels/sms/cancel/route.ts",
      "src/app/api/admin/channels/sms/confirm/route.ts",
      "src/app/api/admin/channels/sms/delete/route.ts",
      "src/app/api/admin/channels/sms/disable/route.ts",
      "src/app/api/admin/channels/sms/status/route.ts",
      "src/app/api/admin/channels/sms/verify/route.ts",

      // Admin business-detail routes: small shared auth/validation scaffolding.
      "src/app/api/admin/businesses/*/keywords/route.ts",
      "src/app/api/admin/businesses/*/ranking/route.ts",
      "src/app/api/admin/businesses/*/route.ts",
      "src/lib/admin/business-detail/update.ts",

      // CSV import parser: the client preview (CsvImportClient.tsx) and the
      // authoritative server parser (csv-import.ts) carry deliberately-parallel
      // copies of the CSV tokeniser. They are behaviourally DIVERGENT — the server
      // parseCsvRecords adds bounds checks (`i + 1 < csvText.length`) the client
      // preview omits — so extracting one shared function would force a behaviour
      // change on the preview path. Pre-existing on main; PR C touched the file
      // (in-file dedup) which brought the clone into the changed-file scope.
      // Ignoring the client side drops the 2-instance group below minOccurrences.
      "src/app/admin/locations/csv-import/CsvImportClient.tsx",

      // Owner settings/account routes: the deep owner+account and writable-owner
      // gates are extracted (requireOwnerWithAccount / requireWritableOwner). The
      // residual clone is the force-dynamic export + the standardized 3-line gate
      // call + per-route locationId/writable guards — framework scaffolding, not
      // extractable without a per-handler HOF wrapper. (dashboard/route.ts dropped
      // out of the clone set once its preamble adopted requireOwnerWithAccount.)
      "src/app/api/account/settings/route.ts",
      "src/app/api/settings/route.ts",
      "src/app/api/settings/voice/route.ts",
      "src/app/api/settings/channels/override/route.ts",
      "src/app/api/settings/channels/overrides/route.ts",
      "src/app/api/locations/display-label/route.ts",

      // Dashboard channel routes: the owner-auth gate is now shared
      // (requireRoleOr401). The residual preamble (flag → env → location →
      // writable-account resolution) diverges by design — start maps no_account
      // → 404 while cancel/disable map it → 403, and each route binds a
      // channel-specific enrollment fn + flag/env helper. Not cleanly unifiable
      // without a config-knobbed helper.
      "src/app/api/dashboard/channels/telegram/cancel/route.ts",
      "src/app/api/dashboard/channels/telegram/disable/route.ts",
      "src/app/api/dashboard/channels/telegram/start/route.ts",
      "src/app/api/dashboard/channels/whatsapp/cancel/route.ts",
      "src/app/api/dashboard/channels/whatsapp/disable/route.ts",
      "src/app/api/dashboard/channels/whatsapp/start/route.ts",

      // Zernio OAuth connect/disconnect: sensitive handshake preamble (ADR 0001),
      // subtle per-route variance; kept per-route.
      "src/app/api/zernio/connect/cancel/route.ts",
      "src/app/api/zernio/connect/start/route.ts",
      "src/app/api/zernio/disconnect/route.ts",

      // Onboarding flow: code self-documents the duplication as intentional
      // (isolation), and it rides the pre-pay demo cost-guard / billing path.
      "src/app/api/onboarding/business/route.ts",
      "src/app/api/onboarding/start/route.ts",
      "src/app/api/onboarding/select-plan/route.ts",
      "src/app/api/onboarding/demo/regenerate/route.ts",
      "src/app/api/onboarding/demo/status/route.ts",
      "src/app/onboarding/demo/PaywallWithDemoClient.tsx",
      "src/app/onboarding/start/StartLocationClient.tsx",

      // Auth/signup routes + form: shared signup scaffold; flows differ per step.
      "src/app/api/auth/finish-signup/route.ts",
      "src/app/api/auth/signup/route.ts",
      "src/app/api/auth/signup-status/route.ts",
      "src/app/api/auth/verify-otp/route.ts",
      "src/app/api/auth/mfa/challenge/route.ts",
      "src/app/api/auth/reset-password/route.ts",
      "src/components/auth/auth-island/SignupForm.tsx",

      // Settings danger-zone panels (CancelSubscription on Billing, DeleteData on
      // Profile) + the channels-tab client: all render the standardized loadError /
      // disabled-guard fallback (a ~4-line styled set-section div) off the shared
      // useOffboardingStatus hook. The Cancel/Delete pair are the deliberately-
      // parallel halves of the former AccountOffboardingPanel, split across the
      // Billing vs Profile routes; the copy + surrounding surface differ per panel,
      // and extracting the shared scaffold would be the thin pass-through component
      // the design rules reject. Acknowledged; cleanup candidates post-launch.
      "src/components/dashboard/settings/CancelSubscriptionPanel.tsx",
      "src/components/dashboard/settings/DeleteDataPanel.tsx",
      "src/app/(authenticated)/settings/channels/ChannelsTabClient.tsx",

      // Dashboard data hooks + approval client: SWR/fetch boilerplate; forcing a
      // generic hook would over-couple distinct data shapes.
      "src/hooks/useAccountData.ts",
      "src/hooks/useDashboardData.ts",
      "src/hooks/useLocationVoiceForm.ts",
      "src/hooks/useSettingsForm.ts",
      "src/components/approval/approval-client.tsx",

      // Aggregate (account-level) vs per-location dashboard cards: render
      // differently by design (different data + richness).
      "src/components/dashboard/aggregate/AggregateIntelligenceBriefCard.tsx",
      "src/components/dashboard/kpi/IntelligenceBriefCard.tsx",

      // Landing/marketing sections: shared animation/section scaffold (count-up
      // already consolidated); section structure kept readable per-section.
      "src/components/sections/features/FeaturesContent.tsx",
      "src/components/sections/landing/Features.tsx",
      "src/components/sections/landing/TimelineSection.tsx",

      // Worker schedulers: a shared poll-loop scaffold (interval env-parse,
      // isPolling reentrancy guard, setInterval lifecycle) wrapping divergent
      // jobs. A createIntervalScheduler factory is tempting, but the lifecycles
      // genuinely differ — OnboardingDrip has an idempotent-start guard + an
      // exported tick + a mock-mode skip; Monthly/Weekly log a timezone. A factory
      // would need behaviour-changing normalization or config knobs, so kept
      // per-scheduler (reliability-sensitive worker loops; production.md).
      "worker/background/schedulers/MonthlyImpactScheduler.ts",
      "worker/background/schedulers/OnboardingDripScheduler.ts",
      "worker/background/schedulers/WeeklySummaryScheduler.ts",

      // Twilio ingress: webhook signature/parse scaffold; each handles a distinct
      // Twilio callback (inbound / delivery-status / shared).
      "worker/ingress/twilio/twilio.ts",
      "worker/ingress/twilio/twilio-whatsapp-inbound.ts",
      "worker/ingress/twilio/twilio-delivery-status.ts",

      // Self-contained admin panel with internal repetition kept for clarity.
      "src/app/admin/businesses/*/_components/ZernioConnectionPanel.tsx",

      // The auto-approval runtime PR threaded lane-specific outbox helpers and
      // approval attribution through these routes/workers; the residual clones
      // are route auth/lock/error scaffolding, extracting which would add wrapper
      // indirection around behaviorally distinct entry points. ZernioReviewIngest
      // is unmodified by this PR but stays co-listed as the paired endpoint of the
      // modified ZernioBackfillWorker's "parallel Zernio ingest setup" clone — the
      // duplicate stays suppressed only while both ends are listed.
      "src/app/api/admin/flagged/route.ts",
      "src/app/api/dashboard/past-replies/draft/route.ts",
      "src/app/api/dashboard/past-replies/draft/*/route.ts",
      "src/app/api/dashboard/past-replies/publish/route.ts",
      "src/app/api/dashboard/past-replies/*/retry/route.ts",
      "src/app/api/dashboard/past-replies/*/restore-original/route.ts",
      "worker/jobs/zernio/ZernioBackfillWorker.ts",
      "worker/jobs/zernio/ZernioReviewIngestWorker.ts",

      // WS6 spec §5 deliberately ships the fourth owner-notice package before
      // extracting a shared notice-package triplet. These channel adapters and
      // renderers are the reviewed, per-provider clone surface; delivery claims,
      // retry classification, and worker orchestration remain notice-specific.
      "src/lib/notifications/channels/email-channel.ts",
      "src/lib/notifications/channels/telegram-body.ts",
      "src/lib/notifications/channels/telegram-channel.ts",
      "src/lib/notifications/channels/whatsapp-channel.ts",
      "src/lib/notifications/email/templates/autonomy-suspended-notice.ts",

      // ── Owner-offboarding feature (acknowledged duplication) ──
      // Offboarding's own routes share the standardized force-dynamic + read-level
      // owner-gate preamble (requireOwnerWithAccount / requireDeleteDataDestructiveAuth)
      // — framework scaffolding, not extractable without a per-handler HOF. The two
      // confirm-flow tx bodies (cancel_only vs delete_data) are deliberately parallel
      // (resolveActiveOrLock + snapshot + audit), the offboarding background pollers
      // share the SKIP-LOCKED-claim-then-revalidate poll-loop scaffold wrapping
      // divergent jobs (same reasoning as the schedulers above — reliability-sensitive,
      // production.md), the two Stripe webhook handlers share subscription-scoping
      // preamble, and startup-assert groups repeated env assertions. Acknowledged.
      "src/app/api/account/offboarding/confirm/route.ts",
      "src/app/api/account/offboarding/keep-my-data/route.ts",
      "src/app/api/account/offboarding/reactivate/route.ts",
      "src/app/api/account/offboarding/retry-billing/route.ts",
      "src/app/api/locations/add/route.ts",
      "src/app/api/locations/reactivate/route.ts",
      "src/components/dashboard/DashboardContent.tsx",
      "src/lib/account-offboarding/confirm.ts",
      "src/lib/account-offboarding/email-dedup.ts",
      "src/lib/auth/require-owner-access.ts",
      "src/lib/shared/job-outbox-helpers.ts",
      "src/lib/shared/writable-subscription.ts",
      "worker/background/pollers/AccountOffboardingAccessEndPoller.ts",
      "worker/background/pollers/AccountOffboardingPurgePoller.ts",
      "worker/background/pollers/AccountOffboardingPurgeReminderPoller.ts",
      "worker/background/pollers/AccountOffboardingReactivationResetPoller.ts",
      "worker/background/pollers/AccountOffboardingTeardownRetryPoller.ts",
      "worker/config/startup-assert.ts",
      "worker/ingress/stripe/subscription-deleted.ts",
      "worker/ingress/stripe/subscription-updated.ts",
      // Shared teardown/purge worker family: snapshot-driven staged provider
      // workflows that share a small getStripe()/error-classifier + step-stamp
      // scaffold across each provider step (Stripe/Zernio/locations/outbox). The
      // bounded Stripe retry-classifier is intentionally co-located per worker
      // (reliability-sensitive; production.md) rather than hoisted into a shared
      // module across the worker/lib boundary. The fresh-auth cookie helper mirrors
      // the existing signed-cookie helpers (approval cookies, zernio connect
      // session) — same HMAC-cookie shape, distinct secrets/payloads.
      "worker/jobs/account-offboarding/BillingScheduleWorker.ts",
      "worker/jobs/account-offboarding/TeardownWorker.ts",
      "worker/jobs/account-offboarding/PurgeWorker.ts",
      "worker/jobs/account-offboarding/purge-stages.ts",
      "worker/jobs/account-offboarding/teardown-stripe.ts",
      "worker/jobs/account-offboarding/teardown-locations.ts",
      "worker/jobs/account-offboarding/teardown-zernio.ts",
      "worker/jobs/account-offboarding/teardown-outbox.ts",
      "src/lib/account-offboarding/reactivate.ts",
      "src/lib/account-offboarding/destructive-auth.ts",
      "src/lib/approval/cookies.ts",
      "src/lib/zernio/connect-session-cookie.ts",
      "src/app/api/billing/checkout/route.ts",
      "src/app/api/billing/tier-change/route.ts",
      "src/components/dashboard/settings/DeleteDataOffboardingModal.tsx",
      "src/app/(authenticated)/layout.tsx",
      "src/app/(authenticated)/settings/auto-approval/AutoApprovalClient.tsx",
      "src/app/(public)/pricing/PricingContent.tsx",
      "worker/jobs/response-generation/load-context.ts",
      "worker/jobs/response-generation/persist.ts",

      // ── Public-pages UX polish (acknowledged) ──
      // login/error.tsx + signup/error.tsx are Next.js error-boundary convention
      // files — minimal '({ error, reset })' boilerplate, same framework category
      // as the page.tsx glob ignored above. OnboardingFunnelShell + PageShell share
      // the decorative parallax glass-card block; merging would couple the
      // onboarding funnel to PageShell (two intentionally-separate island shells).
      "src/app/**/error.tsx",
      "src/app/onboarding/_shared/OnboardingFunnelShell.tsx",
      "src/components/ui/PageShell.tsx",

      // ── Multi-location billing-recovery hardening (PR D) ──
      // The error-inspection VOCABULARY (type sets, network codes, property
      // readers) formerly cloned between stripe-overage-error.ts and
      // account-offboarding/stripe-invoices.ts now lives in the shared
      // src/lib/payments/stripe-error-inspect.ts; each worker keeps only its
      // own retry POLICY (the divergent 409-in-flight rule). The entry stays
      // because the two thin policy functions still share their if-chain shape
      // by design and must not be merged into one policy.
      "worker/jobs/billing/stripe-overage-error.ts",

      // ── Auto-approved post FYI (Workstream B) ──
      // AutoPostNoticeWorker + its context loader deliberately parallel the approval
      // NotificationWorker/context skeleton: the shared fragments are worker entry
      // boilerplate (job.data destructuring + outbox handle + load context) and the
      // eligibility guard around the ALREADY-shared getEligibleChannels primitive. The two
      // workers/contexts diverge in their real logic (pending_approval approval-link dispatch
      // vs posted+auto_policy FYI fan-out; different SELECT/WHERE), so extracting the glue
      // would add a pass-through the design rules reject. Ignoring the FYI side drops each
      // 2-instance group below minOccurrences.
      "worker/jobs/auto-post-notice/AutoPostNoticeWorker.ts",
      "worker/jobs/auto-post-notice/context.ts",

      // ── Beta-launch alerting gate (this PR) ──
      // SerpAPI call blocks: serpapi-source (reviews) and RankingTrackingWorker
      // (local-pack ranking) both bound getJson with SERPAPI_TIMEOUT_MS and throw
      // on response.error, but parse divergent shapes (response.reviews vs
      // local_results + place_id match). The only shared sliver is the timeout +
      // error-throw guard; extracting it would be a thin wrapper over getJson the
      // design rules reject. This PR's ranking-timeout fix brought the pre-existing
      // pair into changed-file scope. Ignoring the ranking side drops the group.
      "worker/jobs/RankingTrackingWorker.ts",
      // Redis option assembly: the Upstash cache client (src/lib/db/redis-cache)
      // and the BullMQ queue connection (worker/redis-connection) are DELIBERATELY
      // separate (CLAUDE.md: "two Redis instances, different providers — do not
      // collapse them"). The parallel URL->{host,port,password,db,tls} parse is
      // intentional; this PR's commandTimeout addition shifted lines and brought
      // the pre-existing clone into changed-file scope. Ignoring the queue side
      // drops the group.
      "worker/redis-connection.ts",

      // ── Stage-3 src-lib config batch (this PR) ──
      // owner-leads-sheet.ts: the two Google Sheets fetch blocks — the OAuth
      // token exchange (~:94-107) and the values:append call (~:155-164) — share
      // a parallel `fetch → if (!response.ok) throw → await response.json()`
      // shape. They are behaviourally distinct (different endpoints, bodies, and
      // success shapes: a token vs an updatedRows count) and pre-exist on main.
      // This PR's edit only touched readConfig() (OWNER_LEADS_*/GOOGLE_SHEETS_*
      // now read via getServerConfig()), which shifted line numbers and brought
      // the pre-existing clone into fallow's changed-file scope. Acknowledged —
      // extracting a shared fetch helper would be a thin pass-through the design
      // rules reject.
      "src/lib/google/owner-leads-sheet.ts",

      // ── Admin console redesign Phase 3 (relocations + mechanical palette/formatter touches) ──
      // Five 2-instance clone groups, ALL of them byte-identical pairs that
      // already existed on `origin/main` (verified block-by-block with
      // `git show origin/main:<path>`). None is new copy-paste — Phase 3 only
      // pulled them into the changed-file scope of `--gate new-only`. Following
      // the convention used for the CsvImportClient / RankingTrackingWorker /
      // redis-connection entries above, exactly ONE side of each pair is listed,
      // which drops the group below `minOccurrences: 2` while leaving the other
      // side visible to anyone running `fallow dupes` locally.
      //
      // BusinessDetailClient.tsx:31-47 ↔ admin/overview/OverviewClient.tsx:32-47
      // — the HEALTH_BADGE_STYLES/LABELS maps + the `HealthBadge` span. This pair
      // is verbatim on main between `businesses/[id]/page.tsx:17-31` and the same
      // OverviewClient block; the relocation to BusinessDetailClient.tsx renamed
      // one side, nothing more. Churn health is a derived engagement score, not a
      // subscription/job status, so it is deliberately NOT the shared StatusBadge
      // (the component's own comment says so). Ignoring the detail side keeps the
      // Overview copy on the radar.
      "src/app/admin/businesses/*/BusinessDetailClient.tsx",
      // ManualRankingSection.tsx covers two groups, both pre-existing on main:
      //   :114-124 ↔ ChannelsPanel.tsx:74-84 — the `overflow-x-auto` + `<thead>`
      //     table-header scaffold. Present verbatim on main (ChannelsPanel:41-48
      //     / ManualRankingSection:114-121); the columns differ (Channel/Handle/
      //     Status/Last activity vs Date/Keyword/Rank/Source), so the clone is
      //     the Tailwind chrome only. Phase 3 already routed the LIST tables onto
      //     the shared DataTable primitive; these two are in-panel sub-tables
      //     that DataTable's column/paging model does not fit.
      //   :88-97 ↔ TrackedKeywordsSection.tsx:25-30 — the standard
      //     `if (!res.ok) { json.catch(() => ({})); throw new Error(error ?? HTTP n) }`
      //     fetch-error idiom. Present once each on main in ProfileEditor,
      //     TrackedKeywordsSection and ManualRankingSection; extracting it would
      //     be the thin pass-through the design rules reject.
      "src/app/admin/businesses/*/_components/ManualRankingSection.tsx",
      // TrackedKeywordsSection.tsx:25-30 ↔ ProfileEditor.tsx:157-162 — the same
      // pre-existing fetch-error idiom as above, third instance.
      "src/app/admin/businesses/*/_components/TrackedKeywordsSection.tsx",
      // ReviewsList.tsx:16-21 (`formatStars`) ↔
      // src/lib/notifications/email/templates/shared.ts:14-19 (`renderStars`) —
      // the clamped `'★'.repeat()` guard. Byte-identical on main on both sides
      // (only the comments differ, each naming its own crash mode: the admin
      // reviews list vs an email send). They sit on opposite sides of the
      // UI/worker-template boundary and are 6 lines; sharing them would couple an
      // admin React component to the email template module. Ignoring the admin
      // side keeps the email helper visible.
      "src/app/admin/businesses/*/_components/ReviewsList.tsx"
    ]
  }
}
