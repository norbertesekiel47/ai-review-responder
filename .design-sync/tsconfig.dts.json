{
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "../src",
    "outDir": "./.cache/types",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": false,
    "noEmitOnError": false,
    "allowJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "paths": {
      "@/lib/*": [
        "../src/lib/*"
      ],
      "@/types/*": [
        "../src/types/*"
      ],
      "@/*": [
        "../src/*"
      ]
    },
    "types": []
  },
  "include": [
    "../src/components/ui/**/*.ts",
    "../src/components/ui/**/*.tsx",
    "../src/components/sections/**/*.ts",
    "../src/components/sections/**/*.tsx",
    "./ambient.d.ts"
  ],
  "exclude": [
    "../src/**/__tests__/**",
    "../src/**/*.test.*",
    "../src/**/*.spec.*"
  ]
}
