{
  "description": "RepWorth feature-mode guards and stop-time validation.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/edit-surface-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/migration-immutability-guard.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/bash-write-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/typecheck-on-stop.sh\"",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/stop-gate.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/norbertesekiel/.agents/skills/impeccable/scripts/impeccable' ] || '/Users/norbertesekiel/.agents/skills/impeccable/scripts/impeccable' hook",
            "commandWindows": "if exist \"/Users/norbertesekiel/.agents/skills/impeccable/scripts/impeccable.cmd\" (\"/Users/norbertesekiel/.agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/Users/norbertesekiel/.agents/skills/impeccable/scripts/impeccable' ] || '/Users/norbertesekiel/.agents/skills/impeccable/scripts/impeccable' hook",
            "commandWindows": "if exist \"/Users/norbertesekiel/.agents/skills/impeccable/scripts/impeccable.cmd\" (\"/Users/norbertesekiel/.agents/skills/impeccable/scripts/impeccable.cmd\" hook & exit /b)",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ]
  }
}
