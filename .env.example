# =============================================================================
# RepWorth — Environment Variables
# =============================================================================
# Copy to .env.local and fill in actual values. NEVER commit .env.local to git.
# Server-only vars: SUPABASE_SERVICE_KEY, *_WEBHOOK_SECRET, *_SECRET
# =============================================================================

# --- Database (Supabase) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
DATABASE_POOL_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_KEY=eyJ...                   # SERVER-ONLY

# --- Public Supabase (safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Redis — TWO logically separate roles (cache vs BullMQ queue) ---
# Development: one local Redis, two DB indexes (dev-stack.sh starts it for you).
REDIS_CACHE_URL=redis://localhost:6379/0      # DB 0 for cache
REDIS_QUEUE_URL=redis://localhost:6379/1      # DB 1 for BullMQ queue
#
# Production topology (see docs/runbooks/deployment-guide.md §1.4):
#   cache  → Upstash (TLS; Vercel-reachable; low volume)
#   queue  → Railway Redis, colocated with the worker over PRIVATE networking
#            (no public proxy → no egress; this is the fix for the egress bill)
#
# Cache (Upstash), set on Vercel + the Railway worker:
# REDIS_CACHE_URL=rediss://default:YOUR_TOKEN@YOUR_HOST.upstash.io:6379/0
# REDIS_CACHE_TOKEN=                          # Only needed for the Upstash REST URL (https://) form
#
# Queue (Railway Redis), set ONLY on the Railway worker. `?family=0` is REQUIRED —
# Railway's private network is IPv6-only and ioredis/BullMQ won't resolve
# *.railway.internal without it. Never use the Railway public proxy URL here.
# REDIS_QUEUE_URL=redis://default:${{redis.REDISPASSWORD}}@${{redis.RAILWAY_PRIVATE_DOMAIN}}:6379/1?family=0
# REDIS_QUEUE_TOKEN=                          # Unused with Railway (no token)

# --- LLM Providers ---
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-api03-...
# Gate the OpenAI Moderation provider layer (worker-only). Off → local regex
# rules only (output-filter.ts). 'true' → also call moderations.create and merge.
# Fail-open by design (a provider error never blocks generation).
OPENAI_MODERATION_ENABLED=false

# --- Review Data ---
SERPAPI_API_KEY=...
# SerpAPI per-request timeout in ms (default in code).
# SERPAPI_TIMEOUT_MS=10000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Zernio (GBP review ingestion + reply posting) ---
# Single flag controls BOTH ingestion AND publishing (no separate flags).
ZERNIO_PUBLISHING_ENABLED=false
# Required when ZERNIO_PUBLISHING_ENABLED=true (worker startup assertion fails otherwise):
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=                        # SERVER-ONLY — HMAC; must match the Zernio dashboard exactly
# Optional — defaults live in code:
# ZERNIO_API_BASE=https://zernio.com/api      # override for sandbox
# ZERNIO_PROFILE_ID_PREFIX=repworth-prod-     # prevents prod/staging/local profile-name collisions
# ZERNIO_INGEST_MAX_PAGES=4                   # backfill page cap (~200 reviews)
# ZERNIO_RECENT_REVIEW_POLL_DISABLED=false
# ZERNIO_RECENT_REVIEW_POLL_MAX_PAGES=4
# ZERNIO_RECENT_REVIEW_POLL_MAX_CONNECTIONS=100
# ZERNIO_RECENT_REVIEW_POLL_CONCURRENCY=3
# ZERNIO_RECENT_REVIEW_POLL_DEADLINE_MS=240000

# --- Notifications ---
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=                        # SERVER-ONLY
RESEND_FROM_EMAIL="RepWorth <notifications@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=your-admin@email.com
# Recipient for public contact / demo-request / lead-intake notification emails.
# Falls back to the RESEND_FROM_EMAIL mailbox, then noreply@repworth.com, with a
# loud warning — set this in prod (Vercel) so leads reach a monitored inbox.
CONTACT_NOTIFY_TO=
# Mailbox advertised in the List-Unsubscribe header on marketing emails.
# Unset → falls back to the RESEND_FROM_EMAIL mailbox; if that is also unparseable,
# marketing emails fail Gmail/Outlook bulk-sender compliance. Set in prod (Railway).
LIST_UNSUBSCRIBE_EMAIL=
# One-click HTTPS unsubscribe endpoint advertised alongside the mailto above
# (distinct var from LIST_UNSUBSCRIBE_EMAIL). Optional.
LIST_UNSUBSCRIBE_URL=
# NOTIFICATION_FAILOVER_INTERVAL_MS=72000
# NOTIFICATION_FAILOVER_DISABLED=false

# --- Owner lead intake ---
# Optional sales-team mirror. Share the Sheet with GOOGLE_SHEETS_CLIENT_EMAIL.
OWNER_LEADS_GOOGLE_SHEET_ID=
OWNER_LEADS_GOOGLE_SHEET_RANGE=Sheet1!A:K
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET= # SERVER-ONLY

# --- Stripe Price IDs (REQUIRED for billing) ---
# All 6 immutable monthly Prices must be set when SELF_SERVE_SIGNUP_ENABLED=true.
# Create new Prices in Stripe; never edit an existing Price's amount.
STRIPE_PRICE_COPILOT_LIST=          # $29 Copilot monthly base
STRIPE_PRICE_COPILOT_FOUNDING=      # $19 Copilot monthly founding base
STRIPE_PRICE_AUTOPILOT_LIST=        # $69 Autopilot monthly base
STRIPE_PRICE_AUTOPILOT_FOUNDING=    # $49 Autopilot monthly founding base
STRIPE_PRICE_COPILOT_OVERAGE=       # $15 Copilot extra location
STRIPE_PRICE_AUTOPILOT_OVERAGE=     # $20 Autopilot extra location
# Strict UTC timestamp. Missing/malformed fails closed to list pricing.
FOUNDING_DEADLINE=2027-01-01T00:00:00Z
# Enables Stripe Tax on checkout sessions (automatic_tax + address + tax-id
# collection). Keep OFF until Stripe Tax is enabled in the dashboard and every
# Price has a tax_behavior — otherwise checkout session creation throws.
STRIPE_TAX_ENABLED=false
# SERVER-ONLY (Vercel, NOT the worker; no NEXT_PUBLIC companion). Stripe Coupon
# ID — 100% off, duration=repeating, duration_in_months=3 — comped onto an
# admin-invited beta tester's checkout. Test-mode ID on staging, live-mode ID in
# prod; they differ. Unset (or blank) = comp OFF for NEW checkout attempts only:
# an attempt already snapshotted keeps its coupon, which is the per-attempt
# Stripe idempotency contract. See .claude/reference/env-vars.md.
BETA_COMP_COUPON_ID=
# --- Security ---
SESSION_COOKIE_SECRET=                        # SERVER-ONLY — random 32+ char string
CSRF_SECRET=                                  # SERVER-ONLY — random 32+ char string
# VESTIGIAL — not read by any application code. RepWorth has no symmetric
# encryption; approval/channel tokens are SHA-256 HASHED (node:crypto createHash),
# not encrypted. Kept commented pending full removal — do NOT rely on these.
# ENCRYPTION_KEY=
# ENCRYPTION_KEY_VERSION=1

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public worker origin: webhook signature base.
# Must match provider dashboards exactly (scheme, host, no trailing slash).
WORKER_PUBLIC_URL=http://localhost:3001
# SERVER-ONLY shared secret (NOT NEXT_PUBLIC). Authenticates the admin jobs panel's
# server-side fetch to the worker's GET /internal/queue-health endpoint (#408).
# Set the SAME value on the Vercel project AND the Railway worker, per env.
# Generate with: openssl rand -hex 32
# Optional — when unset the endpoint returns 503 and the panel shows queue depth as
# "unavailable" (never breaks boot).
WORKER_INTERNAL_SECRET=
# VESTIGIAL — superseded by WORKER_PUBLIC_URL (0 code references). Kept commented
# pending removal.
# WORKER_SERVICE_URL=http://localhost:3001

# --- Observability ---
# Sentry DSN — get from Sentry: Project → Settings → Client Keys (DSN). Same
# value for server and browser. Blank = Sentry disabled locally (no events sent).
# REQUIRED in production on BOTH surfaces: the Railway worker hard-gates on it at
# boot (assertAlertSinkEnv — it is the mandatory non-email P0/P1 alert sink, so a
# missing DSN aborts staging/prod worker startup), and Vercel needs it or the
# deployed frontend won't report errors.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=                       # Same DSN, exposed to browser for client-side error reporting
SENTRY_ORG=                                   # Sentry org slug (for source map upload)
SENTRY_PROJECT=                               # Sentry project slug (for source map upload)
SENTRY_AUTH_TOKEN=                            # Sentry auth token (for source map upload, CI only)
# Label on JSON structured log lines (cosmetic). Worker leaves unset; set to
# 'web' (or similar) where another process emits logs.
# LOG_SERVICE=worker
#
# --- Deployment lane (platform-injected — DO NOT SET HERE) ---
# RAILWAY_ENVIRONMENT_NAME is injected by Railway ('staging' / 'production') and is the
# source for src/lib/config/deployment-lane.ts: the Sentry `environment` tag, the worker's
# production-only boot gates, and the logger's error_stack gate all read the lane, not
# NODE_ENV (NODE_ENV can't name it — staging runs NODE_ENV=production, production leaves it
# unset; #610/#611, ADR 0013).
# WARNING: setting it in a local .env makes requiresProductionConfig() true locally, which
# turns on the production boot gates and SUPPRESSES error_stack in your local logs. There is
# no reason to set it by hand — leave it to Railway.

# --- Product analytics (PostHog Cloud) ---
# Optional. Worker analytics no-op when unset.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Mock mode (set to 'true' to bypass SerpAPI + LLM calls) ---
MOCK_EXTERNAL_APIS=false

# --- Dev-only: disable NotificationFailoverPoller ---
# The poller detects approval responses stuck for 4+ hours and sends an
# admin alert (it does NOT re-dispatch — that was removed in Phase 0).
# Stale detection gates on notification_deliveries.sent_at, which the
# dispatcher writes directly, so delivery webhooks are no longer a
# dependency. Set to 'true' in .env.local only if you want to suppress
# admin-alert emails during local development while you have stuck
# pending_approval responses in the DB. The worker also auto-disables
# when MOCK_EXTERNAL_APIS=true. Leave unset in production.
# See docs/plans/adding-communication-channels.md §3.5.
# NOTIFICATION_FAILOVER_DISABLED=true

# --- Added in Phase 5 (GBP API) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GCP_PROJECT_ID=


# --- Ranking tracking (Sprint 5B) — disabled by default ---
RANKING_TRACKING_ENABLED=false
# RANKING_TRACKING_INTERVAL_MS=3600000         # Scheduler poll interval (default 1 hour)

# --- Cost ceilings (cents/day) ---
# Per-tier ceilings are required operator-supplied positive integers with no defaults.
# The global ceiling remains optional with its established code default.
DAILY_COST_LIMIT_CENTS_COPILOT=
DAILY_COST_LIMIT_CENTS_AUTOPILOT=
# GLOBAL_DAILY_COST_LIMIT_CENTS=10000

# --- WS8 cutover preflight (scripts/ws8-stripe-cutover-preflight.ts) ---
# Subscription IDs an operator has REVIEWED and accepted as inert orphans: provider
# subscriptions with no account projection, which Stripe cannot delete and which
# therefore block the cutover gate forever in any environment whose database was
# reset. Comma/space separated. Unset = strict default (every orphan blocks).
# Narrow by construction: only TERMINAL (canceled/incomplete_expired) subscriptions
# can be accepted — a live one always blocks — and each acceptance is logged as
# `WARN reviewed_orphan_subscription`. Read only by the preflight CLI, never runtime.
WS8_PREFLIGHT_REVIEWED_ORPHAN_SUBS=

# --- Email send (chokepoint timeout; default in code) ---
# EMAIL_SEND_TIMEOUT_MS=10000                  # per-send Resend timeout (src/lib/notifications/email/send-email.ts)

# --- Health-alert poller (beta-launch gate; all optional, defaults in code) ---
# SENTRY_DSN is REQUIRED in production (assertAlertSinkEnv) — it is the non-email alert sink.
# HEALTH_ALERT_POLL_INTERVAL_MS=300000         # 5min
# HEALTH_ALERT_PENDING_AGE_S=900               # oldest claimable outbox age → warn
# HEALTH_ALERT_STALE_DISPATCHING_S=600         # dispatching age → error (watchdog down)
# HEALTH_ALERT_FAILED_WINDOW_S=3600            # window for terminal failed outbox rows
# HEALTH_ALERT_FAILED_THRESHOLD=0              # failed public-path jobs tolerated (0 → any pages)
# HEALTH_ALERT_FLAGGED_OPEN_THRESHOLD=5        # open flagged_responses backlog → warn
# HEALTH_ALERT_ZERO_DELIVERY_WINDOW_S=3600     # window for completed-but-undelivered notifications
# HEALTH_ALERT_BACKLOG_DEPTH_THRESHOLD=1500    # per-table pending backlog depth → warn (#474 capacity target)
# HEALTH_ALERT_MONITOR_SLUG=health-alert-poller  # Sentry Cron monitor slug (dead-man heartbeat)

# --- Poller / scheduler tuning (all optional; defaults in code) ---
# OUTBOX_BATCH_SIZE=50
# OUTBOX_POLL_INTERVAL_MS=
# ARCHIVAL_INTERVAL_MS=
# CANCELLATION_GRACE_INTERVAL_MS=
# ENGAGEMENT_MONITOR_INTERVAL_MS=
# EMAIL_CHANNEL_RECONCILE_INTERVAL_MS=600000   # 10min
# EMAIL_CHANNEL_RECONCILE_BATCH_SIZE=100
# EMAIL_CHANNEL_RECONCILE_DISABLED=false
# ANALYTICS_DISPATCH_POLL_INTERVAL_MS=30000
# ANALYTICS_DISPATCH_BATCH_SIZE=50
# STRIPE_LOCATIONS_RECONCILE_INTERVAL_MS=3600000   # 1h
# STRIPE_LOCATIONS_RECONCILE_DISABLED=false
# ONBOARDING_DRIP_INTERVAL_MS=3600000          # 1h
# WEEKLY_SUMMARY_SCHEDULER_INTERVAL_MS=
# MONTHLY_IMPACT_SCHEDULER_INTERVAL_MS=

# (WORKER_PUBLIC_URL is defined once in the "App URLs" section above.)

# --- Telegram channel (Phase 2) ---
# Server-authoritative flag. When false (default), Telegram widget is
# hidden, admin API routes 404, dispatcher skips telegram enrollments,
# factory throws on getChannel('telegram'). Read by the business detail
# API via response field `telegramEnabled`. No NEXT_PUBLIC_* companion.
CHANNELS_TELEGRAM_ENABLED=false

# BotFather token for @RepWorthBot (or the configured bot). Required
# when CHANNELS_TELEGRAM_ENABLED=true (worker startup assertion fails
# otherwise, except in MOCK_EXTERNAL_APIS=true). Rotate via BotFather;
# old tokens auto-invalidate on the Telegram side.
TELEGRAM_BOT_TOKEN=

# Shared secret (32+ byte random string) for the X-Telegram-Bot-Api-
# Secret-Token header. MUST match what was passed to setWebhook. See
# docs/operational-runbook.md for the one-time setWebhook curl. Rotate
# by re-running setWebhook with a new value + updating this env var.
TELEGRAM_WEBHOOK_SECRET=

# Optional — bot username used for deep-link rendering in the admin
# enrollment widget. Default: RepWorthBot.
TELEGRAM_BOT_USERNAME=RepWorthBot

# --- Telegram channel (Phase 2) (end) ---

# --- Channels — WhatsApp ────────────────────────────────────────────────
# Flag. Default false; flip to true only after Meta verification + WABA +
# Twilio WA sender provisioned + approved template SID.
CHANNELS_WHATSAPP_ENABLED=false
# Required when flag on. Format: whatsapp:+<digits>
TWILIO_WHATSAPP_NUMBER=
# Required when flag on. Twilio Content SID (HX...) for repworth_approval_request_v1.
WHATSAPP_APPROVAL_TEMPLATE_SID=
# Required when flag on. Must equal NEXT_PUBLIC_APP_URL + '/approve/'.
# Boot-time assertion enforces this; mismatch = staging/local sending URLs
# the Meta-approved template does not point at.
WHATSAPP_APPROVAL_URL_BASE=
# Twilio credentials (shared by the WhatsApp channel).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Enable owner editing/regenerating/republishing of already-posted replies from
# the Reviews list. Sole gate since #678 retired PAST_REPLIES_VIEW_ENABLED.
# Read by BOTH Next.js and the worker. Server-authoritative (no NEXT_PUBLIC_ companion).
EDIT_REPLIES_ENABLED=false

# --- More feature flags (server-authoritative; behavior in .claude/reference/env-vars.md) ---
# Multi-location surface (add-location wizard, /api/locations/*, switcher, aggregate scope).
MULTI_LOCATION_ENABLED=false
# Import-on-ingestion of externally-answered replies. Requires migration 031.
# (Its companion UI flag PAST_REPLIES_VIEW_ENABLED was retired at #678 — the
# Reviews list renders unconditionally, so imported replies show as soon as this is on.)
EXTERNAL_REPLY_IMPORT_ENABLED=false
# Master kill-switch for blocking MFA enforcement (AAL2 redirect on page navigation).
MFA_ENFORCEMENT_ENABLED=false
# Pre-pay onboarding demo lane (/onboarding/start + /onboarding/demo).
ONBOARDING_DEMO_ENABLED=false
# ONBOARDING_DEMO_DAILY_CENTS=1000             # global $/day ceiling for the demo lane
# ONBOARDING_DEMO_STAFF_EMAILS_CSV=            # soft-launch staff allowlist (comma-separated)
# Card-up-front Stripe-native free trial. Default false; server-authoritative,
# no NEXT_PUBLIC companion. When true (AND self-serve signup is on), self-serve
# checkout creates the subscription with subscription_data.trial_period_days and
# the account enters the 'trialing' status (full product, $0 now, Stripe
# auto-charges the captured card at trial end). Ranking tracking is excluded
# from trials. See .claude/reference/env-vars.md for the full behavior.
TRIAL_ENABLED=false
TRIAL_PERIOD_DAYS=30
# Auto-approval runtime kill switch. Default false; no NEXT_PUBLIC companion.
# Runtime auto-posting needs OPENAI_MODERATION_ENABLED=true (above) + a clean
# per-draft verdict. AUTO_APPROVAL_PROVIDER_MODERATION_READY additionally gates
# owner-settings *expansion* (turning auto on / broader). Settings expansion is
# also blocked on genuine per-PR Vercel Preview deploys, detected via the
# auto-injected VERCEL_TARGET_ENV ('preview'); the staging custom env reports
# VERCEL_TARGET_ENV='staging' and is NOT blocked. You never set these yourself.
AUTO_APPROVAL_ENABLED=false
AUTO_APPROVAL_PROVIDER_MODERATION_READY=false
# Sale + policy-expansion authorization. Effective Autopilot purchasability is
# this exact server-only boolean AND AUTO_APPROVAL_ENABLED; default false.
AUTOPILOT_PURCHASABLE=false
# Owner offboarding runtime kill switch. Default false; no NEXT_PUBLIC companion.
# Leave off until the full 7-PR sequence completes and the staging dry-run passes.
ACCOUNT_OFFBOARDING_ENABLED=false
# Optional offboarding poller tunables — all have safe code defaults; uncomment only to tune.
# Interval (ms) / batch size for each recovery poller (defaults 60000 / 25, except
# teardown-retry batch 10):
# ACCOUNT_OFFBOARDING_ACCESS_END_INTERVAL_MS=60000
# ACCOUNT_OFFBOARDING_ACCESS_END_BATCH_SIZE=25
# ACCOUNT_OFFBOARDING_PURGE_INTERVAL_MS=60000
# ACCOUNT_OFFBOARDING_PURGE_BATCH_SIZE=25
# ACCOUNT_OFFBOARDING_PURGE_REMINDER_INTERVAL_MS=60000
# ACCOUNT_OFFBOARDING_PURGE_REMINDER_BATCH_SIZE=25
# ACCOUNT_OFFBOARDING_REACTIVATION_RESET_INTERVAL_MS=60000
# ACCOUNT_OFFBOARDING_REACTIVATION_RESET_BATCH_SIZE=25
# ACCOUNT_OFFBOARDING_TEARDOWN_RETRY_INTERVAL_MS=60000
# ACCOUNT_OFFBOARDING_TEARDOWN_RETRY_BATCH_SIZE=10
# Stalled-teardown re-drive caps (default 12 retries / 5-min cooldown):
# ACCOUNT_OFFBOARDING_TEARDOWN_MAX_RETRIES=12
# ACCOUNT_OFFBOARDING_TEARDOWN_RETRY_COOLDOWN_MS=300000
# NOTE: ACCOUNT_OFFBOARDING_PURGE_WINDOW_OVERRIDE_MS is intentionally omitted — it is a
# staging/non-prod-only purge-window shortener (refused when NODE_ENV/VERCEL_ENV=production)
# and must never be set in production. See .claude/reference/env-vars.md.
# Known gap (#614): the override widens the poller's claim predicate without writing
# purge_after, so the purge-after-token-expiry trigger cannot fire on that path — it can
# purge early and revoke a live keep-my-data token. That is why this refusal deliberately
# still reads NODE_ENV/VERCEL_ENV and was NOT migrated to the deployment lane (ADR 0013).

# --- Docs ---
# Makes /admin/runbook doc names clickable links. Leave unset to disable.
# NEXT_PUBLIC_DOCS_BASE_URL=

# --- Self-serve signup ---
# Gates /signup, /login, /forgot-password, /reset-password, /api/auth/* (owner-only
# endpoints) and CleanupAbandonedSignupsPoller. Admin surfaces never gated.
SELF_SERVE_SIGNUP_ENABLED=false

# Cleanup poller tuning (optional; defaults shown)
# CLEANUP_ABANDONED_SIGNUPS_INTERVAL_MS=86400000
# CLEANUP_ABANDONED_SIGNUPS_BATCH_SIZE=100

# Signing secret for admin impersonation session cookies (HMAC-SHA256).
# Required for the admin view-as feature; must be at least 32 characters.
# Generate with: openssl rand -hex 32
IMPERSONATION_COOKIE_SECRET=

# --- Test / CI only (not needed to run the app) ---
# Hard gate for DB integration + Playwright E2E; suites skip gracefully when unset.
# TEST_DATABASE_POOL_URL=
# E2E_OWNER_EMAIL=                              # confirmed owner login on the test Supabase (owner-login E2E specs)
# E2E_OWNER_PASSWORD=                           # password for E2E_OWNER_EMAIL — never hardcode creds in spec files
# E2E_DATABASE_URL=                             # optional: Postgres URL for raw-psql E2E fixtures (else falls back to TEST_DATABASE_POOL_URL)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# ALLOW_E2E_DB_WRITES=false                     # opt-in guard for destructive E2E DB writes
# E2E_ADMIN_TEST_BUSINESS_ID=                   # fixture business id for admin E2E specs
