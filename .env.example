# =============================================================================
# RepWorth — Environment Variables
# =============================================================================
# Copy to .env.local and fill in actual values. NEVER commit .env.local to git.
# Server-only vars: SUPABASE_SERVICE_KEY, *_WEBHOOK_SECRET, *_SECRET
# =============================================================================

# --- Database (Supabase) ---
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres
DATABASE_POOL_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
SUPABASE_URL=https://YOUR_REF.supabase.co
SUPABASE_SERVICE_KEY=eyJ...                   # SERVER-ONLY

# --- Public Supabase (safe for browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Redis — TWO logically separate instances ---
# Development: local Docker Redis (run: docker run -d --name redis-dev -p 6379:6379 redis:7-alpine)
REDIS_CACHE_URL=redis://localhost:6379/0      # DB 0 for cache
REDIS_QUEUE_URL=redis://localhost:6379/1      # DB 1 for BullMQ queue
# Production (Upstash or Railway Redis):
# REDIS_CACHE_URL=rediss://default:YOUR_TOKEN@YOUR_HOST:6379
# REDIS_CACHE_TOKEN=                          # Only needed for Upstash REST URLs (https://)
# REDIS_QUEUE_URL=rediss://default:YOUR_TOKEN@YOUR_HOST:6379
# REDIS_QUEUE_TOKEN=                          # Only needed for Upstash REST URLs (https://)

# --- LLM Providers ---
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Review Data ---
SERPAPI_API_KEY=...
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Notifications ---
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=                        # SERVER-ONLY
RESEND_FROM_EMAIL="RepWorth <notifications@yourdomain.com>"
ADMIN_NOTIFICATION_EMAIL=your-admin@email.com
# NOTIFICATION_FAILOVER_INTERVAL_MS=72000
# NOTIFICATION_FAILOVER_DISABLED=false

# --- Payments ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...               # SERVER-ONLY
STRIPE_PAYMENT_LINK_FOUNDING=https://buy.stripe.com/xxx  # Founding Member $99/mo Payment Link
STRIPE_PAYMENT_LINK_STANDARD=https://buy.stripe.com/yyy  # Standard $149/mo Payment Link
STRIPE_PRICE_FOUNDING=price_xxx               # Stripe Price ID for Founding tier
STRIPE_PRICE_STANDARD=price_yyy               # Stripe Price ID for Standard tier

# --- Security ---
ENCRYPTION_KEY=                               # SERVER-ONLY — random 32-byte hex (openssl rand -hex 32)
ENCRYPTION_KEY_VERSION=1
SESSION_COOKIE_SECRET=                        # SERVER-ONLY — random 32+ char string
CSRF_SECRET=                                  # SERVER-ONLY — random 32+ char string

# --- Admin auth (stopgap until Sprint 3 Supabase Auth) ---
# Leave blank for local dev (all admin requests allowed when unset)
# Set in production to lock down /api/admin/* routes
ADMIN_API_KEY=

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
WORKER_SERVICE_URL=http://localhost:3001
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=                       # Same DSN, exposed to browser for client-side error reporting
SENTRY_ORG=                                   # Sentry org slug (for source map upload)
SENTRY_PROJECT=                               # Sentry project slug (for source map upload)
SENTRY_AUTH_TOKEN=                            # Sentry auth token (for source map upload, CI only)

# --- Mock mode (set to 'true' to bypass SerpAPI + LLM calls) ---
MOCK_EXTERNAL_APIS=false

# --- Dev-only: disable NotificationFailoverPoller ---
# The poller detects approval responses stuck for 4+ hours and sends an
# admin alert (it does NOT re-dispatch — that was removed in Phase 0).
# Stale detection gates on notification_deliveries.sent_at, which the
# dispatcher writes directly, so delivery webhooks are no longer a
# dependency. Set to 'true' in .env.local only if you want to suppress
# admin-alert emails during local development while you have stuck
# pending_approval responses in the DB. The worker also auto-disables
# when MOCK_EXTERNAL_APIS=true. Leave unset in production.
# See docs/adding-communication-channels.md §3.5.
# NOTIFICATION_FAILOVER_DISABLED=true

# --- Added in Phase 5 (GBP API) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GCP_PROJECT_ID=

# --- Mock mode (set to 'true' to bypass SerpAPI + LLM calls) ---
MOCK_EXTERNAL_APIS=

# --- Ranking tracking (Sprint 5B) — disabled by default ---
RANKING_TRACKING_ENABLED=false
# RANKING_TRACKING_INTERVAL_MS=3600000         # Scheduler poll interval (default 1 hour)

# --- Configurable (defaults in code) ---
# OUTBOX_BATCH_SIZE=50
# DAILY_COST_LIMIT_CENTS_FOUNDING=500
# DAILY_COST_LIMIT_CENTS_STANDARD=1000
# GLOBAL_DAILY_COST_LIMIT_CENTS=10000

# Worker public URL — statusCallback base for outbound SMS + path
# component of Twilio signature verification. MUST match the URL
# configured in the Twilio console exactly (scheme, host, no trailing
# slash).
WORKER_PUBLIC_URL=

# --- SMS channel (Phase 1) ---
# Master flag (server-authoritative, single source of truth). When false
# (default), SMS widget is hidden, API routes 404, dispatcher skips sms
# enrollments, factory throws on getChannel('sms'). The admin UI reads the
# flag via the business detail API response (no client-bundle companion).
CHANNELS_SMS_ENABLED=false

# Twilio credentials (from console.twilio.com). Required when
# CHANNELS_SMS_ENABLED=true (worker startup assertion fails otherwise,
# except in MOCK_EXTERNAL_APIS=true mode).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Messaging Service SID (NOT a raw phone number). The Messaging Service
# can hold multiple senders (toll-free interim + 10DLC final); Twilio
# selects the sender per their dashboard priority config.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verify service SID — separate from Messaging Service. Used for OTP
# codes during enrollment.
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMS cost ceilings (per calendar day, cents). Defaults in code are 10
# per-business and 500 global.
SMS_DAILY_LIMIT_CENTS_PER_BUSINESS=10
SMS_DAILY_LIMIT_CENTS_GLOBAL=500


# --- Telegram channel (Phase 2) ---
# Server-authoritative flag. When false (default), Telegram widget is
# hidden, admin API routes 404, dispatcher skips telegram enrollments,
# factory throws on getChannel('telegram'). Read by the business detail
# API via response field `telegramEnabled`. No NEXT_PUBLIC_* companion.
CHANNELS_TELEGRAM_ENABLED=false

# BotFather token for @RepWorthBot (or the configured bot). Required
# when CHANNELS_TELEGRAM_ENABLED=true (worker startup assertion fails
# otherwise, except in MOCK_EXTERNAL_APIS=true). Rotate via BotFather;
# old tokens auto-invalidate on the Telegram side.
TELEGRAM_BOT_TOKEN=

# Shared secret (32+ byte random string) for the X-Telegram-Bot-Api-
# Secret-Token header. MUST match what was passed to setWebhook. See
# docs/operational-runbook.md for the one-time setWebhook curl. Rotate
# by re-running setWebhook with a new value + updating this env var.
TELEGRAM_WEBHOOK_SECRET=

# Optional — bot username used for deep-link rendering in the admin
# enrollment widget. Default: RepWorthBot.
TELEGRAM_BOT_USERNAME=RepWorthBot

# --- Telegram channel (Phase 2) (end) ---

# --- Channels — WhatsApp ────────────────────────────────────────────────
# Flag. Default false; flip to true only after Meta verification + WABA +
# Twilio WA sender provisioned + approved template SID.
CHANNELS_WHATSAPP_ENABLED=false
# Required when flag on. Format: whatsapp:+<digits>
TWILIO_WHATSAPP_NUMBER=
# Required when flag on. Twilio Content SID (HX...) for repworth_approval_request_v1.
WHATSAPP_APPROVAL_TEMPLATE_SID=
# Required when flag on. Must equal NEXT_PUBLIC_APP_URL + '/approve/'.
# Boot-time assertion enforces this; mismatch = staging/local sending URLs
# the Meta-approved template does not point at.
WHATSAPP_APPROVAL_URL_BASE=
# Reused from SMS + shared sections:
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, WORKER_PUBLIC_URL, NEXT_PUBLIC_APP_URL

# --- Self-serve signup ---
# Gates /signup, /login, /forgot-password, /reset-password, /api/auth/* (owner-only
# endpoints) and CleanupAbandonedSignupsPoller. Admin surfaces never gated.
SELF_SERVE_SIGNUP_ENABLED=false

# Cleanup poller tuning (optional; defaults shown)
# CLEANUP_ABANDONED_SIGNUPS_INTERVAL_MS=86400000
# CLEANUP_ABANDONED_SIGNUPS_BATCH_SIZE=100
