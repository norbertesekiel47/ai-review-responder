{
  "name": "repworth",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "bash scripts/dev-stack.sh",
    "worktree:new": "bash scripts/new-worktree.sh",
    "prebuild": "tsx scripts/prebuild-assert-client-config.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed origin/main",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node -e \"require('dotenv').config({path:'.env.local'});if(!process.env.TEST_DATABASE_POOL_URL){console.error('TEST_DATABASE_POOL_URL required for integration hard gate — set it in the shell or .env.local');process.exit(1)}\" && vitest run worker/jobs/publisher/__tests__/integration-edit-existing-reply.test.ts",
    "test:e2e": "playwright test",
    "ci:tenant-scope": "tsx scripts/ci/tenant-scope-audit.ts",
    "ci:rls-audit": "tsx scripts/ci/rls-audit.ts",
    "ci:analytics-events": "tsx scripts/ci/analytics-events-audit.ts",
    "ci:static-policy": "tsx scripts/ci/static-policy-audit.ts",
    "ci:response-status": "tsx scripts/ci/response-status-audit.ts",
    "ci:admin-aal2": "tsx scripts/ci/admin-aal2-audit.ts",
    "ci:config-coverage": "tsx scripts/ci/config-coverage-audit.ts",
    "ci:process-env": "tsx scripts/ci/process-env-audit.ts",
    "ci:db-imports": "tsx scripts/ci/db-imports-audit.ts",
    "ci:fallow": "fallow audit --gate new-only --fail-on-issues --base ${FALLOW_BASE:-origin/main}",
    "worker": "tsx worker/index.ts",
    "redis": "tsx scripts/redis.ts",
    "eval:llm": "tsx tests/llm-eval/run.ts",
    "verify:stripe-prices": "tsx scripts/verify-stripe-price-parity.ts",
    "doctor": "npx react-doctor@latest",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/nextjs": "^10",
    "@sentry/node": "^10.55.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.14",
    "botid": "^1.5.11",
    "bullmq": "^5.77.6",
    "dotenv": "^17.4.2",
    "fastest-levenshtein": "^1.0.16",
    "fastify": "^5.8.5",
    "fastify-raw-body": "^5.0.0",
    "franc-min": "^6.2.0",
    "ioredis": "^5.11.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.11",
    "next": "^16.2.6",
    "openai": "^6.39.1",
    "postgres": "^3.4.9",
    "posthog-node": "^5.35.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "resend": "^6.12.4",
    "serpapi": "^2.2.1",
    "stripe": "^22.2.0",
    "twilio": "^6.0.2",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.65.0",
    "@types/node": "^25.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.1",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.8",
    "postcss": "^8.5.15",
    "react-doctor": "^0.2.14",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
