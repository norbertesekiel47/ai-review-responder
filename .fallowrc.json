{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": [
    "react-dom",
    "postcss-load-config",
    "eslint-config-next"
  ],
  "entry": [
    "scripts/clear-signup-rate-limits.ts",
    "scripts/zernio-backfill-external-replies.ts",
    "scripts/posthog-backfill-activations.ts"
  ],
  "ignoreExports": [
    {
      "file": "worker/background/pollers/CleanupAbandonedSignupsPoller.ts",
      "exports": ["runOnce"]
    },
    {
      "file": "worker/background/pollers/EmailChannelReconcilePoller.ts",
      "exports": ["runOnce"]
    },
    {
      "file": "worker/background/pollers/StripeLocationsReconcilePoller.ts",
      "exports": ["runOnce"]
    },
    {
      "file": "worker/background/pollers/ZernioRecentReviewPoller.ts",
      "exports": ["runOnce"]
    }
  ],
  "health": {
    "ignore": ["**/dist/**", "**/__generated__/**"]
  },
  "duplicates": {
    "ignoreImports": true,
    "minOccurrences": 3,
    "ignore": [
      "**/__tests__/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "e2e/**",
      "**/*.stories.tsx",
      "src/app/**/page.tsx",
      "scripts/ci/**"
    ]
  }
}
