    77	export function buildReputationSummary(input: {
    78	  rate: RateWindowRow;
    79	  star: StarWindowRow;
    80	  timeSaved: TimeSavedWindowRow;
    81	  trend: SentimentTrendRow[];
    82	  pendingApprovalCount: number;
    83	  /** Location age in whole days; drives the ramping rule. */
    84	  accountAgeDays: number;
    85	}): ReputationSummary {
    86	  const { rate, star, timeSaved, trend, pendingApprovalCount, accountAgeDays } = input;
    87	
    88	  const responseRateCurrent =
    89	    rate.received_current > 0
    90	      ? (rate.handled_current / rate.received_current) * 100
    91	      : null;
    92	  const responseRatePrior =
    93	    rate.received_prior > 0 ? (rate.handled_prior / rate.received_prior) * 100 : null;
    94	
    95	  const timeSavedCurrent = timeSaved.handled_current * MINUTES_SAVED_PER_RESPONSE;
    96	  const timeSavedPrior = timeSaved.handled_prior * MINUTES_SAVED_PER_RESPONSE;
    97	
    98	  return {
    99	    averageStar: buildMetric(star.star_current, star.star_prior, star.star_n_prior, 2),
   100	    responseRate: buildMetric(responseRateCurrent, responseRatePrior, rate.received_prior, 0),
   101	    timeSavedMinutes: buildMetric(timeSavedCurrent, timeSavedPrior, timeSaved.handled_prior, 0),
   102	    pendingApprovalCount,
   103	    trend: trend.map((row) => ({
   104	      weekStart: String(row.week_start),
   105	      starEquivalent: starEquivalent(row.avg_score == null ? null : Number(row.avg_score)),
   106	      reviewCount: Number(row.cnt ?? 0),
   107	    })),
   108	    isRamping: accountAgeDays < RAMPING_AGE_DAYS,
   109	  };
   110	}

