   180	
   181	async function startReviewRun(
   182	  tx: TxClient,
   183	  input: {
   184	    reviewId: string;
   185	    businessId: string;
   186	    correlationId?: string;
   187	    stepKey: 'review_ingested' | 'review_updated';
   188	  },
   189	): Promise<string | null> {
   190	  const [biz] = await tx<{ account_id: string }[]>`
   191	    SELECT account_id FROM businesses WHERE id = ${input.businessId}
   192	  `;
   193	  // Defensive: unreachable today — reviews.business_id FK guarantees the row
   194	  // exists (KEY SHARE from the INSERT / cascade blocks behind our review lock).
   195	  // Skip rather than fail ingest if that ever changes.
   196	  if (!biz) return null;
   197	
   198	  const { runId } = await startOrGetActiveRun(tx, {
   199	    kind: 'review_handler',
   200	    subjectType: 'review',
   201	    subjectId: input.reviewId,
   202	    accountId: biz.account_id,
   203	    businessId: input.businessId,
   204	    correlationId: input.correlationId,
   205	  });
   206	  await recordStep(tx, { runId, stepKey: input.stepKey });
   207	  return runId;
   208	}
