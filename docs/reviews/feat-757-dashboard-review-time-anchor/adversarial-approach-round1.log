     1	// src/lib/kpi/fragments.ts
     2	//
     3	// Single owner of the Review-time anchor spelling (#688 ADR 0019, consolidated
     4	// by #757). Extracted from the consumer-less Stack A KPI service — which #757
     5	// then deleted — so the RENDERED dashboard stack (dashboard/service.ts +
     6	// dashboard/aggregate-queries.ts) composes the same bucketing decision instead
     7	// of re-spelling it. fragments.test.ts fails if any non-test source file
     8	// outside this one spells the anchor.
     9	//
    10	// Each factory returns a lazy Postgres.js fragment (a nested sql`` template —
    11	// never awaited on its own; it composes into a caller's template text + bound
    12	// params). Neither spells a FROM/JOIN nor a tenant-scope predicate, so neither
    13	// can hide — or need — a tenant-scope predicate of its own: every caller keeps
    14	// `business_id = `/`account_id = ` written out literally in its own template,
    15	// because scripts/ci/tenant-scope-audit.ts reads only raw, un-evaluated
    16	// template text. Do NOT move a tenant predicate or a FROM/JOIN in here.
    17	//
    18	// NOT A VARIATION SEAM. Nothing varies across this module — it exists for
    19	// LOCALITY of one load-bearing spelling (the openFlagExistsSql precedent,
    20	// #730). Do not add an "anchor strategy", a registry, or an injected clock
    21	// behind it; a second bucketing rule would be a new ADR, not a new branch here.
    22	
    23	import type { Sql } from 'postgres';
    24	
    25	/** Table alias prefix at a composition site. Callers alias `reviews` as `r`. */
    26	type ReviewsPrefix = '' | 'r.';
    27	
    28	/**
    29	 * Review-time anchor (#688, ADR 0019) — the timestamp the reputation KPIs
    30	 * (velocity, rating breakdown, avg star, sentiment trend) bucket on, so a
    31	 * consented Review import lands in its true weeks instead of spiking the
    32	 * import week.
    33	 *
    34	 * LEAST ignores NULLs in Postgres: a NULL review_date falls back to
    35	 * detected_at, and a clock-skewed FUTURE review_date clamps to detected_at
    36	 * (unclamped, a future week silently vanishes from a trend's generate_series
    37	 * LEFT JOIN). The anchor can never exceed detected_at.
    38	 *
    39	 * Workflow KPIs — response rate, the aggregate review counters, the
    40	 * MonthlyImpactWorker digest — deliberately stay on detected_at: imported
    41	 * unanswered reviews are MEANT to drag the rate (#675 nudge reasoning,
    42	 * ADR 0019 D2). Action timestamps (approved_at) never use this.
    43	 */
    44	export function reviewTimeAnchor(sql: Sql, prefix: ReviewsPrefix) {
    45	  return prefix === 'r.'
    46	    ? sql`LEAST(r.review_date, r.detected_at)`
    47	    : sql`LEAST(review_date, detected_at)`;
    48	}
    49	
    50	/**
    51	 * Single-sided rolling review-time lookback in DAYS. Two-sided (current vs
    52	 * prior) buckets and week-based lookbacks compose {@link reviewTimeAnchor}
    53	 * directly instead — one fragment per predicate shape, not per call site.
    54	 * The window reaches SQL only as a bound integer via make_interval (#403).
    55	 */
    56	export function reviewTimeWindowFilter(sql: Sql, prefix: ReviewsPrefix, windowDays: number) {
    57	  return sql`${reviewTimeAnchor(sql, prefix)} >= NOW() - make_interval(days => ${windowDays})`;
    58	}
     1	// src/lib/kpi/__tests__/fragments.test.ts
     2	//
     3	// Unit pins for the Review-time anchor fragments (#757, ADR 0019) plus the
     4	// single-owner source audit that keeps `src/lib/kpi/fragments.ts` the ONLY
     5	// place the anchor is spelled.
     6	//
     7	// The first two tests were authored `.todo` before the module existed and were
     8	// converted in Task 2 of the #757 plan. A surviving `.todo` satisfies the
     9	// promised-tests gate while proving nothing; treat one as a review-blocking
    10	// defect.
    11	
    12	import { readFileSync, readdirSync } from 'node:fs';
    13	import { join } from 'node:path';
    14	import type { Sql } from 'postgres';
    15	import { describe, expect, it } from 'vitest';
    16	
    17	import { createMockSql } from '../../../../worker/__tests__/helpers/mock-sql';
    18	import { reviewTimeAnchor, reviewTimeWindowFilter } from '../fragments';
    19	
    20	const OWNER = join('src', 'lib', 'kpi', 'fragments.ts');
    21	const ANCHOR_PATTERN = /LEAST\(\s*(?:[A-Za-z_][\w$]*\.)?review_date\s*,/;
    22	
    23	function sourceFiles(root: string): string[] {
    24	  return readdirSync(root, { recursive: true, encoding: 'utf8' })
    25	    .filter((p) => /\.tsx?$/.test(p) && !p.includes('__tests__'))
    26	    .map((p) => join(root, p));
    27	}
    28	
    29	describe('kpi/fragments — Review-time anchor owner (#757)', () => {
    30	  it('reviewTimeAnchor emits the unprefixed and r.-prefixed spellings and nothing else', async () => {
    31	    const harness = createMockSql();
    32	    const sql = harness.mockSql as unknown as Sql;
    33	    await sql`SELECT ${reviewTimeAnchor(sql, '')} AS a`;
    34	    await sql`SELECT ${reviewTimeAnchor(sql, 'r.')} AS a`;
    35	    expect(harness.sqlCalls[0]!.text).toBe('SELECT LEAST(review_date, detected_at) AS a');
    36	    expect(harness.sqlCalls[1]!.text).toBe('SELECT LEAST(r.review_date, r.detected_at) AS a');
    37	    // No FROM/JOIN and no tenant predicate may ever live in the fragment —
    38	    // ci:tenant-scope reads raw template text and would stop seeing it.
    39	    for (const call of harness.sqlCalls) {
    40	      expect(call.text).not.toMatch(/\bFROM\b|\bJOIN\b|business_id|account_id/);
    41	      expect(call.values).toEqual([]);
    42	    }
    43	  });
    44	
    45	  it('reviewTimeWindowFilter binds the window as an integer parameter, never interpolated text', async () => {
    46	    const harness = createMockSql();
    47	    const sql = harness.mockSql as unknown as Sql;
    48	    await sql`SELECT 1 WHERE ${reviewTimeWindowFilter(sql, '', 30)}`;
    49	    const call = harness.sqlCalls[0]!;
    50	    expect(call.text).toBe(
    51	      'SELECT 1 WHERE LEAST(review_date, detected_at) >= NOW() - make_interval(days => ?)',
    52	    );
    53	    expect(call.text).not.toMatch(/INTERVAL\s+'\d+\s+days'/i);
    54	    expect(call.values).toEqual([30]);
    55	  });
    56	
    57	  it('the Review-time anchor is spelled only in kpi/fragments.ts', () => {
    58	    const offenders = [...sourceFiles('src'), ...sourceFiles('worker')]
    59	      .filter((f) => f !== OWNER && ANCHOR_PATTERN.test(readFileSync(f, 'utf8')));
    60	    // Every composer must go through the fragment. A hand-spelled LEAST in
    61	    // dashboard/service.ts would satisfy the live-DB suite AND the shape pins
    62	    // while leaving fragments.ts dead — this is the only test that catches it.
    63	    expect(offenders).toEqual([]);
    64	  });
    65	});

