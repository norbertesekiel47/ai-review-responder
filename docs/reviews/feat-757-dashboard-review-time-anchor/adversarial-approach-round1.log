   101	 * the canonical `accounts/…/locations/…/reviews/…` shape — capture is
   102	 * best-effort provenance for the future GBP posting adapter, never a reason
   103	 * to fail ingest.
   104	 */
   105	export function normalizeGoogleReviewName(name: unknown): string | null {
   106	  if (typeof name !== 'string') return null;
   107	  const trimmed = name.trim();
   108	  return GOOGLE_REVIEW_RESOURCE_RE.test(trimmed) ? trimmed : null;
   109	}
