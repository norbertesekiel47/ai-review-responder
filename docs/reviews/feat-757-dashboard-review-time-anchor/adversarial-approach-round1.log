   187	async function tombstoneMissingSourceReviews(
   188	  connection: ConnectionRow,
   189	  sourceReviewIds: Set<string>,
   190	  feedComplete: boolean,
   191	): Promise<number> {
   192	  const cutoff = liveIngestCutoff(connection.connected_at);
   193	  if (!cutoff || !feedComplete) return 0;
   194	
   195	  const providerLocationName =
   196	    `zernio://${connection.zernio_account_id}/locations/${connection.zernio_location_id}`;
   197	
   198	  const missing = await sql<{ id: string; provider_review_id: string }[]>`
   199	    SELECT id, provider_review_id
   200	    FROM reviews
   201	    WHERE business_id = ${connection.business_id}
   202	      AND provider = 'zernio'
   203	      AND provider_location_name = ${providerLocationName}
   204	      AND status <> ${REVIEW_STATUS.DELETED}
   205	      AND review_date >= ${cutoff}
   206	      AND provider_review_id <> ALL(${[...sourceReviewIds]}::text[])
   207	  `;
   208	
   209	  if (missing.length === 0) return 0;
   210	  const reviewIds = missing.map((r) => r.id);
   211	
   212	  await sql`
   213	    UPDATE reviews
   214	    SET status = ${REVIEW_STATUS.DELETED}
   215	    WHERE id = ANY(${reviewIds}::uuid[])
   216	      AND status <> ${REVIEW_STATUS.DELETED}
   217	  `;
   218	
   219	  await sql`
   220	    UPDATE responses
   221	    SET status = 'failed',
   222	        posting_error = 'review_deleted_at_source',
   223	        updated_at = NOW()
   224	    WHERE review_id = ANY(${reviewIds}::uuid[])
   225	      AND status = ANY(${[...NON_TERMINAL_STATUSES]}::text[])
   226	  `;
   227	
   228	  return missing.length;
   229	}
   230	
   231	type FetchOutcome =
   232	  | { reviews: ZernioReview[]; feedComplete: boolean }
   233	  | { error: true };
