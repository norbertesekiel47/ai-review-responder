   355	        COUNT(*) FILTER (WHERE ${reviewTimeAnchor(sql, 'r.')} >= DATE_TRUNC('month', NOW()))::int AS current_month,
   356	        COUNT(*) FILTER (
   357	          WHERE ${reviewTimeAnchor(sql, 'r.')} >= DATE_TRUNC('month', NOW()) - INTERVAL '1 month'
   358	            AND ${reviewTimeAnchor(sql, 'r.')} < DATE_TRUNC('month', NOW())
   359	        )::int AS prior_month
   360	      FROM reviews r
   361	      JOIN businesses b ON b.id = r.business_id
   362	      WHERE b.account_id = ${accountId}
   363	        AND b.archived_at IS NULL
   364	        AND ${notDeletedFilter(sql, 'r.')}
   365	    `,
   366	    sql<TtrRow[]>`
   367	      SELECT ${ttrSelectExpr(sql)}
   368	      FROM responses resp
   369	      JOIN reviews r ON r.id = resp.review_id
   370	      JOIN businesses b ON b.id = r.business_id
   371	      WHERE b.account_id = ${accountId}
   372	        AND b.archived_at IS NULL
   373	        AND ${notDeletedFilter(sql, 'r.')}
   374	        AND ${ttrHandledWindowFilter(sql, HANDLED, windowDays)}
   375	    `,
   376	    sql<TrendRow[]>`
   377	      SELECT gs::date AS week_start,
   378	             agg.avg_score::float AS avg_score,
   379	             COALESCE(agg.cnt, 0)::int AS cnt
   380	      FROM generate_series(
   381	        DATE_TRUNC('week', NOW() - make_interval(weeks => ${trendSpanWeeks})),
   382	        DATE_TRUNC('week', NOW()),
   383	        INTERVAL '1 week'
   384	      ) gs
   385	      LEFT JOIN (
   386	        SELECT DATE_TRUNC('week', ${reviewTimeAnchor(sql, 'r.')})::date AS wk,
   387	               AVG(r.sentiment_score) AS avg_score,
   388	               COUNT(*) AS cnt
   389	        FROM reviews r
   390	        JOIN businesses b ON b.id = r.business_id
   391	        WHERE b.account_id = ${accountId}
   392	          AND b.archived_at IS NULL
   393	          AND ${notDeletedFilter(sql, 'r.')}
   394	          AND ${reviewTimeAnchor(sql, 'r.')} >= NOW() - make_interval(weeks => ${trendWeeks})
   395	        GROUP BY DATE_TRUNC('week', ${reviewTimeAnchor(sql, 'r.')})
   396	      ) agg ON agg.wk = gs::date
