    31	export function zernioReviewToNormalized(z: ZernioReview): NormalizedReview {
    32	  if (!z.id || typeof z.id !== 'string' || z.id.trim().length === 0) {
    33	    throw new ZernioReviewNormalizationError('missing review.id', z);
    34	  }
    35	  if (typeof z.rating !== 'number' || z.rating < 1 || z.rating > 5) {
    36	    throw new ZernioReviewNormalizationError(`invalid rating: ${z.rating}`, z);
    37	  }
    38	  if (!z.createTime || isNaN(new Date(z.createTime).getTime())) {
    39	    throw new ZernioReviewNormalizationError(`unparseable createTime: ${z.createTime}`, z);
    40	  }
    41	
    42	  // Sanitize the name BEFORE the Anonymous fallback: a name of only stripped
    43	  // chars (bidi/zero-width) is non-empty pre-sanitize but empty after, so the
    44	  // fallback must run on the sanitized value to honor the empty-name contract.
    45	  const cleanedName = sanitizeReviewerName(z.reviewer?.displayName ?? '');
    46	  const reviewerName = cleanedName.length > 0 ? cleanedName : 'Anonymous';
    47	  const cleanedComment = sanitizeMultilineText(z.comment ?? '');
    48	  const reviewText = cleanedComment.length > 0 ? cleanedComment : null;
    49	
    50	  const review: NormalizedReview = {
    51	    reviewerName,
    52	    starRating: z.rating,
    53	    reviewText,
    54	    reviewDate: z.createTime,
    55	    detectedLanguage: detectLanguage(reviewText),
    56	  };
    57	  return review;
    58	}
