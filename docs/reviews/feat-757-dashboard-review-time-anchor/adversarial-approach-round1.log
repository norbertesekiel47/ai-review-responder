    70	
    71	/** Inverse of classifySentiment's deterministic_star_v1: −1..1 score -> 1..5 stars. */
    72	function starEquivalent(avgScore: number | null): number | null {
    73	  if (avgScore == null || Number.isNaN(avgScore)) return null;
    74	  return round(Math.min(5, Math.max(1, 3 + 2 * avgScore)), 2);
    75	}
