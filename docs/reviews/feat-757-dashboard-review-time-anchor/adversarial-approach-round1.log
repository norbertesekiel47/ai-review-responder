   130	    ? sql`r.detected_at >= NOW() - make_interval(days => ${windowDays})`
   131	    : sql`detected_at >= NOW() - make_interval(days => ${windowDays})`;
   132	}
   133	
   134	/**
   135	 * Review-time anchor (#688, ADR 0019) — the timestamp the reputation KPIs
   136	 * (volume MoM, sentiment trend, avg star) bucket on, so a consented Review
   137	 * import lands in its true months/weeks instead of spiking the import month.
   138	 * LEAST ignores NULLs in Postgres: a NULL review_date falls back to
   139	 * detected_at, and a clock-skewed FUTURE review_date clamps to detected_at
   140	 * (unclamped, a future week silently vanishes from the trend's
   141	 * generate_series LEFT JOIN). Workflow KPIs (response rate) deliberately
   142	 * stay on detected_at — imported unanswered reviews are meant to drag the
   143	 * rate (#675 nudge reasoning).
   144	 */
   145	function reviewTimeAnchor(sql: Sql, prefix: '' | 'r.') {
   146	  return prefix === 'r.'
   147	    ? sql`LEAST(r.review_date, r.detected_at)`
   148	    : sql`LEAST(review_date, detected_at)`;
   149	}
   150	
   151	/** Rolling review-time lookback for the avg-star query (both scopes). */
   152	function reviewTimeWindowFilter(sql: Sql, prefix: '' | 'r.', windowDays: number) {
   153	  return sql`${reviewTimeAnchor(sql, prefix)} >= NOW() - make_interval(days => ${windowDays})`;
   154	}
   155	
   156	/** responses.status membership check against the handled-status vocabulary. */
   157	function handledStatusFilter(sql: Sql, handled: string[]) {
   158	  return sql`resp.status = ANY(${handled}::text[])`;
   159	}
   160	
   161	/**
   162	 * Time-to-respond metric expression — identical for both scopes (always the
   163	 * responses+reviews join). The `SELECT` keyword itself stays literal in each
   164	 * caller's own template — never folded into this fragment — because
   165	 * scripts/ci/tenant-scope-audit.ts's `hasReadOrMutationStatement` gate looks
   166	 * for a literal select/update/delete keyword in the OUTER template text
   167	 * before it will even look for a tenant-scope predicate; hiding it here would
   168	 * make the audit silently skip scanning the caller's query altogether.
   169	 */
   170	function ttrSelectExpr(sql: Sql) {
   171	  return sql`AVG(EXTRACT(EPOCH FROM (resp.approved_at - r.detected_at)) / 3600.0)::float AS avg_hours`;
   172	}
   173	
   174	/** Trailing time-to-respond filters after the tenant-scope predicate. */
   175	function ttrHandledWindowFilter(sql: Sql, handled: string[], windowDays: number) {
   176	  // approved_at >= r.detected_at: a pre-existing Google reply imported by
   177	  // reconcileExternallyAnsweredReview carries its ORIGINAL timestamp, which
   178	  // can predate detection — a negative duration is never our response
   179	  // latency (#688; 16 rows at up to −2.9y measured on staging).
   180	  return sql`${handledStatusFilter(sql, handled)}
   181	        AND resp.approved_at IS NOT NULL
   182	        AND resp.approved_at >= r.detected_at
   183	        AND resp.approved_at >= NOW() - make_interval(days => ${windowDays})`;
   184	}
   185	
   186	export async function getLocationKpiSummary(
   187	  sql: Sql,
   188	  businessId: string,
   189	  window: DashboardWindow = DEFAULT_DASHBOARD_WINDOW,
   190	): Promise<DashboardKpiSummary> {
   191	  // Cache read fails open: a Redis blip degrades to a fresh computation.
   192	  const cacheKey = locationKpiCacheKey(businessId, window);
   193	  try {
   194	    const cached = await getCacheRedis().get(cacheKey);
   195	    if (cached) {
   196	      return JSON.parse(cached) as DashboardKpiSummary;
   197	    }
   198	  } catch (err) {
   199	    console.error('[kpi/service] cache read failed (computing fresh):', err);
   200	  }
   201	
   202	  // Window intervals are PARAMETERIZED: windowDays / trendWeeks come from the
   203	  // fixed lookup in ./types and reach SQL only as bound integers via
   204	  // make_interval(...) — never interpolated text (issue #403). `30d` (default)
   205	  // reproduces the legacy 30-day / 8-week behavior exactly. reviewVolume stays
   206	  // calendar-month regardless of window, per the KpiReviewVolume contract.
   207	  const { windowDays, trendWeeks } = dashboardWindowParams(window);
   208	  const trendSpanWeeks = trendWeeks - 1;
   209	  // CONCURRENT AT FAN-OUT 5, POOL 8 (#505/#769 sweep). The only caller is
   210	  // src/app/api/dashboard/kpis/route.ts, which passes `sqlRead` — the dedicated
   211	  // read bulkhead whose max is clamped to [WEDGE_SAFE_READ_MIN,
   212	  // READ_POOL_MAX_CEILING] = [8, 8] (src/lib/db/server.ts), NOT the singleton
   213	  // `sql` at DB_POOL_MAX = 3. This wave is exactly what WEDGE_SAFE_READ_MIN was
   214	  // sized for: 5 here, +1 for the route's concurrent subscription gate = 6 peak,
   215	  // under 8. Adding members past 8 — or routing this onto `sql` — reintroduces
   216	  // the wedge; both are deliberate decisions, not drive-by changes.
   217	  const [rateRows, starRows, volumeRows, ttrRows, trendRows] = await Promise.all([
   218	    sql<RateRow[]>`
   219	      SELECT
   220	        COUNT(*)::int AS received,
   221	        COUNT(*) FILTER (
   222	          WHERE EXISTS (
   223	            SELECT 1 FROM responses resp
   224	            WHERE resp.review_id = r.id
   225	              AND ${handledStatusFilter(sql, HANDLED)}
   226	          )
   227	        )::int AS handled
   228	      FROM reviews r
   229	      WHERE r.business_id = ${businessId}
   230	        AND ${notDeletedFilter(sql, 'r.')}
   231	        AND ${detectedAtWindowFilter(sql, 'r.', windowDays)}
   232	    `,
   233	    sql<StarRow[]>`
   234	      SELECT AVG(star_rating)::float AS avg
   235	      FROM reviews
   236	      WHERE business_id = ${businessId}
   237	        AND ${notDeletedFilter(sql, '')}
   238	        AND star_rating IS NOT NULL
   239	        AND ${reviewTimeWindowFilter(sql, '', windowDays)}
   240	    `,
   241	    sql<VolumeRow[]>`
   242	      SELECT
   243	        COUNT(*) FILTER (
   244	          WHERE ${reviewTimeAnchor(sql, '')} >= DATE_TRUNC('month', NOW())
   245	        )::int AS current_month,
   246	        COUNT(*) FILTER (
   247	          WHERE ${reviewTimeAnchor(sql, '')} >= DATE_TRUNC('month', NOW()) - INTERVAL '1 month'
   248	            AND ${reviewTimeAnchor(sql, '')} < DATE_TRUNC('month', NOW())
   249	        )::int AS prior_month
   250	      FROM reviews
   251	      WHERE business_id = ${businessId}
   252	        AND ${notDeletedFilter(sql, '')}
   253	    `,
   254	    sql<TtrRow[]>`
   255	      SELECT ${ttrSelectExpr(sql)}
   256	      FROM responses resp
   257	      JOIN reviews r ON r.id = resp.review_id
   258	      WHERE r.business_id = ${businessId}
   259	        AND ${notDeletedFilter(sql, 'r.')}
   260	        AND ${ttrHandledWindowFilter(sql, HANDLED, windowDays)}
   261	    `,
   262	    sql<TrendRow[]>`
   263	      SELECT gs::date AS week_start,
   264	             agg.avg_score::float AS avg_score,
   265	             COALESCE(agg.cnt, 0)::int AS cnt
   266	      FROM generate_series(
   267	        DATE_TRUNC('week', NOW() - make_interval(weeks => ${trendSpanWeeks})),
   268	        DATE_TRUNC('week', NOW()),
   269	        INTERVAL '1 week'
   270	      ) gs
   271	      LEFT JOIN (
   272	        SELECT DATE_TRUNC('week', ${reviewTimeAnchor(sql, '')})::date AS wk,
   273	               AVG(sentiment_score) AS avg_score,
   274	               COUNT(*) AS cnt
   275	        FROM reviews
   276	        WHERE business_id = ${businessId}
   277	          AND ${notDeletedFilter(sql, '')}
   278	          AND ${reviewTimeAnchor(sql, '')} >= NOW() - make_interval(weeks => ${trendWeeks})
   279	        GROUP BY DATE_TRUNC('week', ${reviewTimeAnchor(sql, '')})
   280	      ) agg ON agg.wk = gs::date
   281	      ORDER BY week_start ASC
   282	    `,
   283	  ]);
   284	
   285	  const summary = assembleSummary(
   286	    { kind: 'location', businessId },
   287	    windowDays,
   288	    rateRows, starRows, volumeRows, ttrRows, trendRows,
   289	  );
   290	
   291	  // Cache write fails open: serve the fresh result even if the write throws.
   292	  try {
   293	    await getCacheRedis().set(cacheKey, JSON.stringify(summary), 'EX', KPI_CACHE_TTL_SECONDS);
   294	  } catch (err) {
   295	    console.error('[kpi/service] cache write failed (serving fresh):', err);
   296	  }
   297	
   298	  return summary;
   299	}
