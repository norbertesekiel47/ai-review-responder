     1	// Launch KPI summary (Spec 11). Distinct from dashboard valueSummary (lifetime
     2	// metrics) — these are windowed (last 30 days / calendar-month / 8-week trend),
     3	// scoped per-location (business_id) or per-account (all active locations).
     4	
     5	export interface KpiResponseRate {
     6	  /** Reviews received in the window that have a handled response. */
     7	  handled: number;
     8	  /** Reviews received in the window (not deleted). */
     9	  received: number;
    10	  /** round(handled/received*100); null when received = 0. */
    11	  ratePct: number | null;
    12	}
    13	
    14	/**
    15	 * Calendar-month based (current vs prior calendar month), NOT the rolling
    16	 * windowDays lookback. See `DashboardKpiSummary.reviewVolume`.
    17	 */
    18	export interface KpiReviewVolume {
    19	  currentMonth: number;
    20	  priorMonth: number;
    21	  /** round((current-prior)/prior*100); null when prior = 0. */
    22	  deltaPct: number | null;
    23	}
    24	
    25	export interface SentimentTrendPoint {
    26	  /** ISO date (week start, Monday per DATE_TRUNC('week', ...)). */
    27	  weekStart: string;
    28	  /** AVG(sentiment_score) that week; null when no reviews. */
    29	  averageScore: number | null;
    30	  reviewCount: number;
    31	}
    32	
    33	export type KpiScope =
    34	  | { kind: 'location'; businessId: string }
    35	  | { kind: 'account'; accountId: string };
    36	
    37	export interface DashboardKpiSummary {
    38	  scope: KpiScope;
    39	  /**
    40	   * Rolling window in days for response rate, avg star rating, time-to-respond,
    41	   * and sentiment-trend lookback. `reviewVolume` is the calendar-month exception
    42	   * — it uses current vs prior calendar month regardless of this value.
    43	   */
    44	  windowDays: number;
    45	  responseRate: KpiResponseRate;
    46	  /** AVG(star_rating) over the window, 2 decimals; null when none. */
    47	  averageStarRating: number | null;
    48	  reviewVolume: KpiReviewVolume;
    49	  /** Owner-action latency (approved_at - detected_at) in hours, 1 decimal; null when none. */
    50	  averageTimeToRespondHours: number | null;
    51	  /** 8-week ascending sentiment series. */
    52	  sentimentTrend: SentimentTrendPoint[];
    53	}
    54	
    55	/**
    56	 * Canonical analytics time-range set. The browser may request any of these via
    57	 * `?window=`; anything else clamps to {@link DEFAULT_DASHBOARD_WINDOW}. This is
    58	 * the ONLY set of values that may ever reach the windowed SQL (as bound
    59	 * integers — never as interpolated text).
    60	 */
    61	export const DASHBOARD_WINDOWS = ['7d', '30d', '90d', '12w'] as const;
    62	
    63	export type DashboardWindow = (typeof DASHBOARD_WINDOWS)[number];
    64	
    65	/** Absent / invalid `?window=` resolves here — keeps today's behavior. */
    66	export const DEFAULT_DASHBOARD_WINDOW: DashboardWindow = '30d';
    67	
    68	/** The two integers a window drives. Both are compile-time constants. */
    69	export interface DashboardWindowParams {
    70	  /** Rolling window in days (response rate, avg star, time-to-respond, current-vs-prior buckets). */
    71	  windowDays: number;
    72	  /** Number of weekly points in the sentiment / velocity trend series. */
    73	  trendWeeks: number;
    74	}
    75	
    76	const WINDOW_PARAMS: Record<DashboardWindow, DashboardWindowParams> = {
    77	  '7d': { windowDays: 7, trendWeeks: 4 },
    78	  // The default (30 days / 8-week trend) reproduces the pre-#403 behavior; this
    79	  // table is the single owner of those legacy values now.
    80	  '30d': { windowDays: 30, trendWeeks: 8 },
    81	  '90d': { windowDays: 90, trendWeeks: 13 },
    82	  '12w': { windowDays: 84, trendWeeks: 12 },
    83	};
    84	
    85	/** Validate + clamp an untrusted `?window=` value to the allowlisted enum. */
    86	export function resolveDashboardWindow(
    87	  raw: string | null | undefined,
    88	): DashboardWindow {
    89	  return (DASHBOARD_WINDOWS as readonly string[]).includes(raw ?? '')
    90	    ? (raw as DashboardWindow)
    91	    : DEFAULT_DASHBOARD_WINDOW;
    92	}
    93	
    94	/** The bound integers for a (already-validated) window. */
    95	export function dashboardWindowParams(
    96	  window: DashboardWindow,
    97	): DashboardWindowParams {
    98	  return WINDOW_PARAMS[window];
    99	}

