    83	const GOOGLE_REVIEW_RESOURCE_RE = /^accounts\/[^/]+\/locations\/([^/]+)\/reviews\/.+$/;
    84	
    85	/**
    86	 * Extract the location id from Zernio's `review.name` field.
    87	 * Returns null on any deviation — caller MUST treat null as fail-closed
    88	 * per spec §6.3 (do NOT process a review whose location can't be parsed,
    89	 * since fan-out across same-account-multi-location businesses would route
    90	 * it to every business otherwise).
    91	 */
    92	export function extractLocationFromReviewName(name: string): string | null {
    93	  if (typeof name !== 'string' || !name) return null;
    94	  const m = name.match(GOOGLE_REVIEW_RESOURCE_RE);
    95	  return m && m[1] ? m[1] : null;
    96	}
