    24	export class ZernioReviewNormalizationError extends Error {
    25	  constructor(reason: string, readonly raw: unknown) {
    26	    super(`${LOG_PREFIX} ${reason}`);
    27	    this.name = 'ZernioReviewNormalizationError';
    28	  }
