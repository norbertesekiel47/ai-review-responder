   347	      WHERE b.account_id = ${accountId}
   348	        AND b.archived_at IS NULL
   349	        AND ${notDeletedFilter(sql, 'r.')}
   350	        AND r.star_rating IS NOT NULL
   351	        AND ${reviewTimeWindowFilter(sql, 'r.', windowDays)}
   352	    `,
   353	    sql<VolumeRow[]>`
