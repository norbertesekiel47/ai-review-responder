   440	function daysSince(date: Date): number {
   441	  return Math.max(0, Math.floor((Date.now() - date.getTime()) / 86_400_000));
   442	}
   443	
   444	/**
   445	 * Windowed reputation metrics: current vs prior `windowDays`-day buckets via
   446	 * FILTER (single round-trip per metric), plus the `trendWeeks`-week sentiment
   447	 * trend and the authoritative pending-approval count. Response-rate history uses
   448	 * `approved_at <= prior window end` so late approvals don't retro-inflate the
   449	 * prior period (PLAN.md A.2). All scoped by business_id. Intervals are
   450	 * PARAMETERIZED (issue #403): `windowDays` / `priorEndDays` (= 2×windowDays) /
   451	 * `trendWeeks` reach SQL only as bound integers via make_interval(...).
   452	 *
   453	 * Avg star and the sentiment trend bucket on the Review-time anchor (ADR 0019,
   454	 * #757); response rate stays on detected_at (workflow KPI) and timeSaved keys
   455	 * on approved_at (action timestamp) — neither may be re-anchored.
   456	 */
   457	async function fetchReputationRows(
   458	  sql: Sql,
   459	  businessId: string,
   460	  windowDays: number,
   461	  trendWeeks: number,
   462	): Promise<{
   463	  rate: RateWindowRow;
   464	  star: StarWindowRow;
   465	  timeSaved: TimeSavedWindowRow;
   466	  trend: SentimentTrendRow[];
   467	  pendingApprovalCount: number;
   468	}> {
   469	  const priorEndDays = windowDays * 2;
   470	  const trendSpanWeeks = trendWeeks - 1;
   471	  // SEQUENTIAL, one query in flight at a time — do NOT re-introduce a Promise.all
   472	  // here (#505). This is a 5-query fan-out on the SHARED `sql` client, whose pool
   473	  // is `DB_POOL_MAX` = 3 on Vercel (src/lib/db/server.ts) — /api/dashboard/route.ts
   474	  // passes that singleton, not the larger `sqlRead`. Fan-out (5) > pool (3) makes
   475	  // postgres.js pipeline the excess queries onto already-open connections over the
   476	  // Supabase Supavisor TRANSACTION pooler; a pipelined query's response parks
   477	  // server-side in state=active / wait_event=ClientRead and is never read — a
   478	  // PERMANENT Connection wedge that leaks one pool slot per render and no
   479	  // server-side timeout can heal (in ClientRead the statement is not executing, so
   480	  // `statement_timeout` never fires). The same defect took the admin portal down
   481	  // on staging 2026-08-10; this is the owner-facing instance of it.
   482	  //
   483	  // The added latency lands only on a cache MISS — buildActiveDashboardData is
   484	  // Redis-cached at DASHBOARD_LOCATION_CACHE_TTL_SECONDS (45s).
   485	  const rateRows = await sql<RateWindowRow[]>`
   486	        SELECT
   487	          COUNT(*) FILTER (
   488	            WHERE r.detected_at >= NOW() - make_interval(days => ${windowDays})
   489	          )::int AS received_current,
   490	          COUNT(*) FILTER (
   491	            WHERE r.detected_at >= NOW() - make_interval(days => ${windowDays})
   492	              AND EXISTS (
   493	                SELECT 1 FROM responses resp
   494	                WHERE resp.review_id = r.id
   495	                  AND resp.business_id = ${businessId}
   496	                  AND resp.status = ANY(${HANDLED}::text[])
   497	              )
   498	          )::int AS handled_current,
   499	          COUNT(*) FILTER (
   500	            WHERE r.detected_at >= NOW() - make_interval(days => ${priorEndDays})
   501	              AND r.detected_at < NOW() - make_interval(days => ${windowDays})
   502	          )::int AS received_prior,
   503	          COUNT(*) FILTER (
   504	            WHERE r.detected_at >= NOW() - make_interval(days => ${priorEndDays})
   505	              AND r.detected_at < NOW() - make_interval(days => ${windowDays})
   506	              AND EXISTS (
   507	                SELECT 1 FROM responses resp
   508	                WHERE resp.review_id = r.id
   509	                  AND resp.business_id = ${businessId}
   510	                  AND resp.status = ANY(${HANDLED}::text[])
   511	                  AND resp.approved_at IS NOT NULL
   512	                  AND resp.approved_at <= NOW() - make_interval(days => ${windowDays})
   513	              )
   514	          )::int AS handled_prior
   515	        FROM reviews r
   516	        WHERE r.business_id = ${businessId}
   517	          AND r.status <> ${REVIEW_STATUS.DELETED}
   518	          AND r.detected_at >= NOW() - make_interval(days => ${priorEndDays})
   519	  `;
   520	  const starRows = await sql<StarWindowRow[]>`
   521	        SELECT
   522	          AVG(star_rating) FILTER (
   523	            WHERE ${reviewTimeAnchor(sql, '')} >= NOW() - make_interval(days => ${windowDays})
   524	          )::float AS star_current,
   525	          COUNT(star_rating) FILTER (
   526	            WHERE ${reviewTimeAnchor(sql, '')} >= NOW() - make_interval(days => ${windowDays})
   527	          )::int AS star_n_current,
   528	          AVG(star_rating) FILTER (
   529	            WHERE ${reviewTimeAnchor(sql, '')} >= NOW() - make_interval(days => ${priorEndDays})
   530	              AND ${reviewTimeAnchor(sql, '')} < NOW() - make_interval(days => ${windowDays})
   531	          )::float AS star_prior,
   532	          COUNT(star_rating) FILTER (
   533	            WHERE ${reviewTimeAnchor(sql, '')} >= NOW() - make_interval(days => ${priorEndDays})
   534	              AND ${reviewTimeAnchor(sql, '')} < NOW() - make_interval(days => ${windowDays})
   535	          )::int AS star_n_prior
   536	        FROM reviews
   537	        WHERE business_id = ${businessId}
   538	          AND status <> ${REVIEW_STATUS.DELETED}
   539	          AND star_rating IS NOT NULL
   540	          AND ${reviewTimeWindowFilter(sql, '', priorEndDays)}
   541	  `;
   542	  const timeSavedRows = await sql<TimeSavedWindowRow[]>`
   543	        SELECT
   544	          COUNT(*) FILTER (
   545	            WHERE resp.approved_at >= NOW() - make_interval(days => ${windowDays})
   546	          )::int AS handled_current,
   547	          COUNT(*) FILTER (
   548	            WHERE resp.approved_at >= NOW() - make_interval(days => ${priorEndDays})
   549	              AND resp.approved_at < NOW() - make_interval(days => ${windowDays})
   550	          )::int AS handled_prior
   551	        FROM responses resp
   552	        JOIN reviews r ON r.id = resp.review_id
   553	        WHERE r.business_id = ${businessId}
   554	          AND resp.business_id = ${businessId}
   555	          AND r.status <> ${REVIEW_STATUS.DELETED}
   556	          AND resp.status = ANY(${HANDLED}::text[])
   557	          AND resp.approved_at IS NOT NULL
   558	          AND resp.approved_at >= NOW() - make_interval(days => ${priorEndDays})
   559	  `;
   560	  const trendRows = await sql<SentimentTrendRow[]>`
   561	        SELECT gs::date AS week_start,
   562	               agg.avg_score::float AS avg_score,
   563	               COALESCE(agg.cnt, 0)::int AS cnt
   564	        FROM generate_series(
   565	          DATE_TRUNC('week', NOW() - make_interval(weeks => ${trendSpanWeeks})),
   566	          DATE_TRUNC('week', NOW()),
   567	          INTERVAL '1 week'
   568	        ) gs
   569	        LEFT JOIN (
   570	          SELECT DATE_TRUNC('week', ${reviewTimeAnchor(sql, '')})::date AS wk,
   571	                 AVG(sentiment_score) AS avg_score,
   572	                 COUNT(*) AS cnt
   573	          FROM reviews
   574	          WHERE business_id = ${businessId}
   575	            AND status <> ${REVIEW_STATUS.DELETED}
   576	            AND ${reviewTimeAnchor(sql, '')} >= NOW() - make_interval(weeks => ${trendWeeks})
   577	          GROUP BY DATE_TRUNC('week', ${reviewTimeAnchor(sql, '')})
   578	        ) agg ON agg.wk = gs::date
   579	        ORDER BY week_start ASC
   580	  `;
   581	  const pendingApprovalCount = await getPendingApprovalCount(sql, businessId);
   582	
   583	  return {
   584	    rate: rateRows[0] ?? {
   585	      received_current: 0,
   586	      handled_current: 0,
   587	      received_prior: 0,
   588	      handled_prior: 0,
   589	    },
   590	    star: starRows[0] ?? {
   591	      star_current: null,
   592	      star_n_current: 0,
   593	      star_prior: null,
   594	      star_n_prior: 0,
   595	    },
   596	    timeSaved: timeSavedRows[0] ?? { handled_current: 0, handled_prior: 0 },
   597	    trend: trendRows,
   598	    pendingApprovalCount,
   599	  };
   600	}
   601	
   602	async function readPendingMarker(businessId: string): Promise<string | null> {
