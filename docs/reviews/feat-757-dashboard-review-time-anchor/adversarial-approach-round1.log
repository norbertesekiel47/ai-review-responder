   400	/**
   401	 * INSERT a `reviews` row for a Zernio review we have never seen locally.
   402	 * Race-safe via `ON CONFLICT (provider, provider_review_name) DO UPDATE SET
   403	 * id = reviews.id RETURNING id` — DO NOTHING + RETURNING leaves no row when
   404	 * the conflicting INSERT loses the race because the snapshot can't see the
   405	 * just-committed sibling. DO UPDATE always RETURNs whether the row was
   406	 * inserted or pre-existing; besides opportunistically backfilling a NULL
   407	 * `google_review_name`, the no-op `SET id = id` triggers no observable
   408	 * change on the row content.
   409	 */
   410	async function insertImportedReview(
   411	  tx: TxClient,
   412	  businessId: string,
   413	  accountId: string,
   414	  locationId: string,
   415	  target: ZernioReview,
   416	): Promise<string | null> {
   417	  const matchFields = fromZernioReview(target);
   418	  const phi = detectLikelyPhi(matchFields.review_text_trimmed);
   419	  if (phi.matched) {
   420	    return null;
   421	  }
   422	
   423	  const providerReviewName = `zernio://${accountId}/locations/${locationId}/reviews/${target.id}`;
   424	  const providerLocationName = `zernio://${accountId}/locations/${locationId}`;
   425	  const reviewContentHash = createHash('sha256')
   426	    .update(`${matchFields.star_rating}|${matchFields.review_text_trimmed}`)
   427	    .digest('hex');
   428	  const sentiment = classifySentiment(matchFields.star_rating);
   429	
   430	  const rows = await tx<{ id: string }[]>`
   431	    INSERT INTO reviews (
   432	      id, business_id, provider, provider_review_id, provider_review_name,
   433	      provider_location_name, google_review_name, reviewer_name, star_rating, review_text,
   434	      review_date, detected_language, review_content_hash, detected_at,
   435	      status, external_reply_ingested_at,
   436	      sentiment_score, sentiment_label, sentiment_classified_at, sentiment_source
   437	    )
   438	    VALUES (
   439	      gen_random_uuid(), ${businessId}, 'zernio', ${target.id},
   440	      ${providerReviewName}, ${providerLocationName},
   441	      ${normalizeGoogleReviewName(target.name)},
   442	      ${matchFields.reviewer_name}, ${matchFields.star_rating},
   443	      ${matchFields.review_text_trimmed},
   444	      to_timestamp(${matchFields.created_at_ms} / 1000.0),
   445	      ${null as unknown as string}, ${reviewContentHash},
   446	      NOW(), 'new', NOW(),
   447	      ${sentiment.score}, ${sentiment.label}, NOW(), ${sentiment.source}
   448	    )
   449	    ON CONFLICT (provider, provider_review_name) DO UPDATE
   450	      SET id = reviews.id,
   451	          google_review_name = COALESCE(reviews.google_review_name, EXCLUDED.google_review_name)
   452	    RETURNING id
   453	  `;
   454	  return rows[0]!.id;
   455	}
