    17	import {
    18	  VELOCITY_H as H,
    19	  VELOCITY_PAD as PAD,
    20	  computeVelocitySummary,
    21	  weekShortLabel,
    22	} from '@/components/dashboard/charts/velocity-math';
    23	import { usePrefersReducedMotion } from '@/hooks/usePrefersReducedMotion';
    24	
    25	// One authoritative per-location palette, shared with AggregateRankingCard so a
    26	// location is the same color in both aggregate charts. Multi-hue on purpose:
    27	// here color encodes WHICH location, so a single sage would erase the signal
    28	// (unlike the owner-facing single-location chart).
    29	const STACK_COLORS = RANKING_COLORS;
    30	
    31	interface Props {
    32	  reviewVelocity: AggregateDashboardData['reviewVelocity'];
    33	  perLocationVelocity: AggregateDashboardData['perLocationVelocity'];
    34	}
    35	
    36	export function AggregateVelocityCard({ reviewVelocity, perLocationVelocity }: Props) {
    37	  const [mode, setMode] = useState<'total' | 'stacked'>('total');
    38	
    39	  const data = reviewVelocity.map((r, i) => ({
    40	    id: r.weekStart,
    41	    label: weekShortLabel(r.weekStart, i, reviewVelocity.length),
    42	    count: r.count,
    43	  }));
    44	  const summary = computeVelocitySummary(data.map((d) => d.count));
    45	
    46	  return (
    47	    <div className="card">
    48	      <div className="card-h2-row">
    49	        <h2>Review Velocity</h2>
    50	        <span style={{ marginLeft: 'auto', fontSize: 12, color: 'var(--rw-app-text-soft)' }}>
    51	          last {data.length} weeks
    52	        </span>
    53	      </div>
    54	
    55	      {/* VAL-DASH-015: stacked-by-location toggle */}
    56	      <div style={{ display: 'flex', gap: 4, padding: 4, background: 'var(--rw-recess)', borderRadius: 9999, width: 'fit-content', marginBottom: 14 }}>
    57	        <button
    58	          type="button"
    59	          className={`tab ${mode === 'total' ? 'active' : ''}`}
    60	          aria-pressed={mode === 'total'}
    61	          onClick={() => setMode('total')}
    62	          style={{ padding: '4px 12px', fontSize: 12 }}
    63	        >
    64	          Total
    65	        </button>
    66	        <button
    67	          type="button"
    68	          className={`tab ${mode === 'stacked' ? 'active' : ''}`}
    69	          aria-pressed={mode === 'stacked'}
    70	          onClick={() => setMode('stacked')}
    71	          style={{ padding: '4px 12px', fontSize: 12 }}
    72	        >
    73	          By Location
    74	        </button>
    75	      </div>
    76	
    77	      {mode === 'total' ? (
    78	        <>
    79	          <div style={{ display: 'flex', gap: 24, marginBottom: 6, flexWrap: 'wrap', alignItems: 'baseline' }}>
    80	            <KpiSummary label="This week" value={summary.lastWeek} delta={summary.deltaPct} />
    81	            <KpiSummary label="Total · last weeks" value={summary.total} />
    82	            <KpiSummary label="Weekly avg" value={summary.avg} />
    83	          </div>
    84	          <VelocityChart data={data} />
    85	        </>
    86	      ) : (
    87	        <StackedVelocityChart perLocationVelocity={perLocationVelocity} />
    88	      )}
    89	    </div>
    90	  );
    91	}
    92	
    93	function StackedVelocityChart({ perLocationVelocity }: { perLocationVelocity: AggregateDashboardData['perLocationVelocity'] }) {
    94	  const { ref, width } = useMeasuredSvg();
    95	  const reduced = usePrefersReducedMotion();
    96	
    97	  if (perLocationVelocity.length === 0) {
    98	    return <div style={{ padding: 24, textAlign: 'center', color: 'var(--rw-app-text-muted)' }}>No velocity data available</div>;
    99	  }
   100	
   101	  // Find all week keys across locations
   102	  const weekSet = new Set<string>();
   103	  for (const loc of perLocationVelocity) {
   104	    for (const v of loc.velocity) {
   105	      weekSet.add(v.weekStart);
   106	    }
   107	  }
   108	  const weeks = Array.from(weekSet).sort();
   109	
   110	  // Build stacked data per week
   111	  const maxStack = weeks.reduce((max, week) => {
   112	    const stack = perLocationVelocity.reduce((sum, loc) => {
   113	      const v = loc.velocity.find((x) => x.weekStart === week);
   114	      return sum + (v?.count ?? 0);
   115	    }, 0);
   116	    return Math.max(max, stack);
   117	  }, 1);
   118	
   119	  const innerH = H - PAD.t - PAD.b;
   120	  const xBand = scaleBand<string>().domain(weeks).range([PAD.l, width - PAD.r]).paddingInner(0.4).paddingOuter(0.2);

