    71	      providerReviewName: `zernio://${accountId}/locations/${locationId}/reviews/${z.id}`,
    72	      providerLocationName: `zernio://${accountId}/locations/${locationId}`,
    73	      googleReviewName: normalizeGoogleReviewName(z.name),
    74	      identityStrategy: 'zernio_id',
    75	    },
