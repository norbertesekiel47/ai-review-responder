+import { RestraintContent } from '@/components/dashboard/restraint/RestraintContent';
+import './restraint.css';
+
+export const dynamic = 'force-dynamic';
+
+/**
+ * `/dashboard/analytics/restraint` — the **Restraint tab** (CONTEXT.md, LOCKED):
+ * the window's total refusal count and its breakdown by **Refusal category**.
+ * Display only — this surface records no refusal, changes no gate, and writes
+ * nothing.
+ *
+ * A route leaf, and nothing more (`analytics/page.tsx` is the same two lines):
+ * the scope, the window and the fetch live in `RestraintContent`, which needs
+ * to be a client component for all three. T6 shipped this file as a standing
+ * shell so its only blocking edge stayed T0; T7 replaced that shell with the
+ * real screen, and the loading branch moved into the orchestrator where the
+ * other branches are.
+ *
+ * The stylesheet stays imported HERE, colocated with the route, so the whole
+ * surface remains one deletable folder — matching requests.css / contacts.css.
+ */
+export default function RestraintPage() {
+  return <RestraintContent />;
+}
diff --git a/src/app/api/dashboard/refusals/route.ts b/src/app/api/dashboard/refusals/route.ts
new file mode 100644
index 00000000..ea5ede5e
--- /dev/null
+++ b/src/app/api/dashboard/refusals/route.ts
@@ -0,0 +1,66 @@
+import { NextRequest, NextResponse } from 'next/server';
+import { jsonResponse } from '@/lib/auth/route-helpers';
+import { sql } from '@/lib/db/server';
+import { getRefusalLog } from '@/lib/refusals/read';
+import {
+  resolveDashboardLocation,
+  resolveDashboardRequest,
+  withDashboardOwnerRead,
+} from '../policy';
+
+/**
+ * The Refusal Log read endpoint — the Restraint tab's only data source.
+ *
+ * THIS IS `agent-team/route.ts` WITH ONE NAME CHANGED. `getRefusalLog` takes
+ * the same `(sql, scope, window)` shape as `getAgentTeamSummary`, so the two
+ * routes read identically on purpose: same owner gate, same request parse, same
+ * aggregate-vs-location branch, same `{ window, ...payload }` body. Anything
+ * that makes this file longer than that one is logic in the wrong module.
+ *
+ * INVARIANT #12 — orchestrate only. Resolve the scope, call `getRefusalLog`
+ * ONCE, return. No source query, no category mapping, no filtering: every one
+ * of those decisions belongs to `@/lib/refusals/read` and its vocabulary, and
+ * `__tests__/refusals-route.test.ts` scans this source to keep them there.
+ *
+ * INVARIANT #15 — this file IS a composition root, which is why it may import
+ * the `sql` singleton and hand it down. The domain module never does.
+ *
+ * REDACTION IS THE POINT (plan §7 risk 1). S1 reads `flagged_responses`, a
+ * deny-all-RLS table, through the RLS-bypassing `postgres` role — application
+ * scoping and application redaction ARE the access control. The read never
+ * selects `flagged_responses.reason`, and this route must never reintroduce it:
+ * it adds no field of its own, and its error arm is `withDashboardOwnerRead`'s
+ * fixed `errorMessage` — never a mapped or echoed database error body, whose
+ * `query`/`parameters`/`detail` can carry the very prose that must not leave
+ * the server. Three tests pin the absence: from the body at any depth, from the
+ * error path, and from the logs.
+ */
+export const dynamic = 'force-dynamic';
+
+export async function GET(request: NextRequest): Promise<NextResponse> {
+  return withDashboardOwnerRead(request, {
+    errorContext: 'api/dashboard/refusals',
+    errorMessage: 'Failed to fetch refusals',
+  }, async ({ user, accountId }) => {
+    const { window, scopePolicy } = resolveDashboardRequest(request, user.locationId);
+
+    if (scopePolicy.mode === 'aggregate') {
+      const log = await getRefusalLog(sql, { kind: 'account', accountId }, window);
+      return jsonResponse({ window, ...log });
+    }
+
+    const location = await resolveDashboardLocation(sql, {
+      accountId,
+      locationId: scopePolicy.locationId,
+      exposure: 'uniform-not-found',
+    });
+    if (!location.ok) return location.response;
+
+    const log = await getRefusalLog(
+      sql,
+      { kind: 'location', accountId, businessId: location.locationId },
+      window,
+    );
+    return jsonResponse({ window, ...log });
+  });
+}
diff --git a/src/components/dashboard/analytics/AnalyticsTabs.tsx b/src/components/dashboard/analytics/AnalyticsTabs.tsx
new file mode 100644
index 00000000..7f54331a
--- /dev/null
+++ b/src/components/dashboard/analytics/AnalyticsTabs.tsx
@@ -0,0 +1,43 @@
+import Link from 'next/link';
+
+interface Props {
+  /** Which routed tab is the current page. */
+  active: 'metrics' | 'restraint';
+}
+
+/**
+ * Routed tab bar for the Analytics surface: `Metrics` (the reputation, volume
+ * and local-ranking grid at `/dashboard/analytics`) and `Restraint` (the
+ * **Restraint tab** — what we chose not to do in the window, and why).
+ *
+ * A **route** tab bar, not a view switch (`docs/design/console/DESIGN.md`
+ * § Tabs): a `<nav>` of plain `next/link` links carrying `aria-current="page"`,
+ * never `role="tab"`. Not `useState` — each route keeps its own server-rendered
+ * data model, exactly as `ReviewsTabs` does, and `active` is a literal at each
+ * call site rather than a `usePathname()` read.
+ *
+ * `CardViewTabs` is deliberately NOT the precedent here; its own comment says
+ * route-level switches are `ReviewsTabs`. Styling is the shared canvas
+ * `.tabs`/`.tab` pill pair (raised, because it sits on the canvas rather than
+ * on a card).
+ */
+export function AnalyticsTabs({ active }: Props) {
+  return (
+    <nav className="tabs" aria-label="Analytics views">
+      <Link
+        href="/dashboard/analytics"
+        className={`tab ${active === 'metrics' ? 'active' : ''}`}
+        aria-current={active === 'metrics' ? 'page' : undefined}
+      >
+        Metrics
+      </Link>
+      <Link
+        href="/dashboard/analytics/restraint"
+        className={`tab ${active === 'restraint' ? 'active' : ''}`}
+        aria-current={active === 'restraint' ? 'page' : undefined}
+      >
+        Restraint
+      </Link>
+    </nav>
+  );
+}
diff --git a/src/components/dashboard/restraint/RestraintContent.tsx b/src/components/dashboard/restraint/RestraintContent.tsx
new file mode 100644
index 00000000..5c243e12
--- /dev/null
+++ b/src/components/dashboard/restraint/RestraintContent.tsx
@@ -0,0 +1,277 @@
+'use client';
+
+import { useEffect, useState, type ReactNode } from 'react';
+import { TopBar } from '@/components/dashboard/shell/TopBar';
+import { LiveRegion } from '@/components/ui/LiveRegion';
+import { AnalyticsTabs } from '@/components/dashboard/analytics/AnalyticsTabs';
+import { PeriodToolbar } from '@/components/dashboard/analytics/PeriodToolbar';
+import { SubscriptionUnavailableCard } from '@/components/dashboard/shell/SubscriptionUnavailableCard';
+import { RestraintReport } from '@/components/dashboard/restraint/RestraintReport';
+import { useDashboardData } from '@/hooks/useDashboardData';
+import { useLocationScope, type LocationScope } from '@/contexts/LocationContext';
+import { isAggregate, perLocationActive } from '@/lib/dashboard/scope';
+import {
+  REFUSAL_CATEGORY_META,
+  REFUSAL_SOURCES,
+} from '@/lib/refusals/vocabulary';
+import type { RefusalCategoryGroup, RefusalEntry, RefusalLog } from '@/lib/refusals/read';
+import {
+  type DashboardWindow,
+  DEFAULT_DASHBOARD_WINDOW,
+} from '@/lib/kpi/types';
+
+/**
+ * `/dashboard/analytics/restraint` — the **Restraint tab**'s orchestrator.
+ *
+ * THIS IS `AnalyticsContent` WITH ONE PAYLOAD SWAPPED. Same `useLocationScope`,
+ * same lifted `period` (so the selection survives the loading/error/data branch
+ * swap and the control stays usable mid-refetch, #403), same `PeriodToolbar` in
+ * the `TopBar` action slot, same `SubscriptionUnavailableCard` branch. Fetching,
+ * the window control and the scope live HERE; the screen below is pure
+ * presentation over one object.
+ *
+ * TWO READS, ON PURPOSE. `/api/dashboard/refusals` answers "what did we hold
+ * back" and nothing else — it carries no subscription field, and widening it to
+ * carry one would put an entitlement decision in a log endpoint. The
+ * subscription gate therefore comes from the shared `/api/dashboard` payload,
+ * exactly as it does on Analytics and Reviews, and `perLocationActive` stays its
+ * single owner. See deviations D16.
+ *
+ * IT RENDERS ITS OWN LOADING AND ERROR SCAFFOLD rather than calling
+ * `renderDashboardStatePanel`: that helper emits a `TopBar` immediately followed
+ * by the content box, leaving nowhere between the two for the routed tab bar,
+ * and `DashboardSurface` has no `'restraint'` member (its file is outside this
+ * feature's edit surface). Same classes, same shape — see deviations D10.
+ */
+export function RestraintContent() {
+  const { currentScope } = useLocationScope();
+  const [period, setPeriod] = useState<DashboardWindow>(DEFAULT_DASHBOARD_WINDOW);
+  const { data, error, loading } = useDashboardData(currentScope, { window: period });
+  const refusals = useRefusalLog(currentScope, period);
+
+  const periodToolbar = <PeriodToolbar value={period} onChange={setPeriod} />;
+
+  // Loading takes precedence over a stale error while data is absent — the same
+  // precedence `renderDashboardStatePanel` applies.
+  if (loading || error !== null || data === null) {
+    const showError = !loading && data !== null && error !== null;
+    return (
+      <RestraintShell periodToolbar={periodToolbar}>
+        {showError ? <RestraintError message={error} /> : <RestraintLoading />}
+      </RestraintShell>
+    );
+  }
+
+  // Invariant #11: entitlement is `perLocationActive`'s call, never a raw status
+  // comparison here. The aggregate payload carries no per-location subscription,
+  // so it passes through — as it does on every other dashboard read surface.
+  if (!isAggregate(data) && perLocationActive(data) === null) {
+    return (
+      <SubscriptionUnavailableCard
+        topBarTitle="Restraint"
+        heading="Your restraint log isn't available right now"
+        body="Your account needs an active subscription to see what we held back."
+      />
+    );
+  }
+
+  return (
+    <RestraintShell periodToolbar={periodToolbar}>
+      {refusals.loading && <RestraintLoading />}
+      {!refusals.loading && refusals.error !== null && (
+        <RestraintError message={refusals.error} />
+      )}
+      {!refusals.loading && refusals.log !== null && (
+        <>
+          <LiveRegion message="Restraint log ready." />
+          <RestraintReport log={refusals.log} period={period} />
+        </>
+      )}
+    </RestraintShell>
+  );
+}
+
+/** TopBar + routed tab bar + the body column, shared by every branch so the
+ *  tabs and the period control never disappear mid-load. */
+function RestraintShell({
+  periodToolbar,
+  children,
+}: {
+  periodToolbar: ReactNode;
+  children: ReactNode;
+}) {
+  return (
+    <>
+      <TopBar
+        title="Restraint"
+        subtitle="What we chose not to do for you, and why."
+      >
+        {periodToolbar}
+      </TopBar>
+      <div className="content content--analytics">
+        {/* First child of the content box, not a capped subnav row: the
+            analytics canvas is full-bleed, so a capped row would leave the tabs
+            inset from every card below them. */}
+        <AnalyticsTabs active="restraint" />
+        <div className="rst-stack">{children}</div>
+      </div>
+    </>
+  );
+}
+
+function RestraintLoading() {
+  return (
+    <>
+      <LiveRegion message="Loading your restraint log…" />
+      <div className="dashboard-skeleton">
+        <div className="skeleton-card-lg" />
+      </div>
+    </>
+  );
+}
+
+function RestraintError({ message }: { message: string }) {
+  return (
+    <>
+      <LiveRegion message={message} level="assertive" />
+      <div className="card">
+        <h2 className="card-h2">Unable to load your restraint log</h2>
+        <p className="rst-error-body">{message}</p>
+      </div>
+    </>
+  );
+}
+
+// ── The read ────────────────────────────────────────────────────────────────
+
+const FETCH_FAILED_MESSAGE = 'Unable to load your restraint log';
+const INCOMPLETE_MESSAGE = 'Your restraint log came back incomplete';
+
+interface RefusalLogState {
+  log: RefusalLog | null;
+  error: string | null;
+  loading: boolean;
+}
+
+/** What one settled fetch produced, stamped with the (scope, window) it was
+ *  fetched FOR. The stamp is what makes the reset below a derivation. */
+interface SettledRefusalLog {
+  scope: LocationScope;
+  period: DashboardWindow;
+  log: RefusalLog | null;
+  error: string | null;
+}
+
+/**
+ * One `RefusalLog` for one scope and one window.
+ *
+ * `period` rather than `window`, deliberately: a parameter named `window` in a
+ * browser module shadows the global for the whole function body.
+ *
+ * THE RESULT IS KEYED BY WHAT IT WAS FETCHED FOR, and "loading" is DERIVED from
+ * that key rather than written by the effect — the rule `useDashboardData`
+ * already follows. Clearing the state at the top of the effect would be a
+ * synchronous `setState` inside an effect body: a cascading render, and a lint
+ * error (`react-hooks/set-state-in-effect`). Comparing the stamp instead means
+ * a scope or window change reads as loading in the SAME render that changed it,
+ * with no stale log ever visible under a new heading.
+ */
+function useRefusalLog(
+  scope: LocationScope,
+  period: DashboardWindow,
+): RefusalLogState {
+  const [settled, setSettled] = useState<SettledRefusalLog | null>(null);
+
+  useEffect(() => {
+    const controller = new AbortController();
+
+    void (async () => {
+      try {
+        const params = new URLSearchParams({ scope, window: period });
+        const response = await fetch(
+          `/api/dashboard/refusals?${params.toString()}`,
+          { headers: { Accept: 'application/json' }, signal: controller.signal },
+        );
+        const body: unknown = await response.json().catch(() => ({}));
+        if (!response.ok) throw new Error(errorMessageOf(body));
+        // A body this guard rejects is a FAULT, not an empty log: the same rule
+        // the vocabulary applies to an unrecognised code. Rendering a
+        // half-understood payload would show the owner a total it cannot back.
+        if (!isRefusalLog(body)) throw new Error(INCOMPLETE_MESSAGE);
+        setSettled({
+          scope,
+          period,
+          // Only the two fields the screen reads. The route replies
+          // `{ window, ...log }`, and carrying its `window` into the view would
+          // give the period two owners.
+          log: { total: body.total, categories: body.categories },
+          error: null,
+        });
+      } catch (cause) {
+        if (controller.signal.aborted) return;
+        setSettled({
+          scope,
+          period,
+          log: null,
+          error: cause instanceof Error ? cause.message : FETCH_FAILED_MESSAGE,
+        });
+      }
+    })();
+
+    return () => controller.abort();
+  }, [scope, period]);
+
+  const fresh = settled !== null && settled.scope === scope && settled.period === period
+    ? settled
+    : null;
+
+  return {
+    log: fresh?.log ?? null,
+    error: fresh?.error ?? null,
+    loading: fresh === null,
+  };
+}
+
+function isObject(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null;
+}
+
+function errorMessageOf(body: unknown): string {
+  return isObject(body) && typeof body.error === 'string'
+    ? body.error
+    : FETCH_FAILED_MESSAGE;
+}
+
+/** Membership tests against the vocabulary's own closed sets — never a
+ *  re-spelled literal, and never a widening cast. */
+const REFUSAL_SOURCE_NAMES: ReadonlySet<string> = new Set(REFUSAL_SOURCES);
+
+function isRefusalCategory(value: unknown): boolean {
+  return typeof value === 'string'
+    && Object.hasOwn(REFUSAL_CATEGORY_META, value);
+}
+
+function isRefusalEntry(value: unknown): value is RefusalEntry {
+  return isObject(value)
+    && typeof value.id === 'string'
+    && typeof value.source === 'string'
+    && REFUSAL_SOURCE_NAMES.has(value.source)
+    && isRefusalCategory(value.category)
+    && typeof value.occurredAt === 'string'
+    && (value.reviewId === null || typeof value.reviewId === 'string');
+}
+
+function isRefusalCategoryGroup(value: unknown): value is RefusalCategoryGroup {
+  return isObject(value)
+    && isRefusalCategory(value.category)
+    && typeof value.count === 'number'
+    && Array.isArray(value.entries)
+    && value.entries.every(isRefusalEntry);
+}
+
+function isRefusalLog(value: unknown): value is RefusalLog {
+  return isObject(value)
+    && typeof value.total === 'number'
+    && Array.isArray(value.categories)
+    && value.categories.every(isRefusalCategoryGroup);
+}
diff --git a/src/components/dashboard/restraint/RestraintReport.tsx b/src/components/dashboard/restraint/RestraintReport.tsx
new file mode 100644
index 00000000..0a87de43
--- /dev/null
+++ b/src/components/dashboard/restraint/RestraintReport.tsx
@@ -0,0 +1,281 @@
+'use client';
+
+import Link from 'next/link';
+import type { DashboardWindow } from '@/lib/kpi/types';
+import {
+  REFUSAL_CATEGORY_META,
+  type RefusalCategory,
+} from '@/lib/refusals/vocabulary';
+// TYPE-ONLY, and that is a requirement rather than a style choice. `read.ts` is
+// server-only — it reaches `@/lib/approval/audit` and therefore `node:crypto`,
+// which Next polyfills for nobody — so a value import here would drag it into
+// the browser bundle. Its header states the same rule from the other side: a
+// component that wants this shape takes it `import type`, as `BatchReport.tsx`
+// takes its `BatchView`. `./vocabulary.ts` above is the client-safe leaf and is
+// imported for real, because the owner labels live there.
+import type {
+  RefusalCategoryGroup,
+  RefusalEntry,
+  RefusalLog,
+} from '@/lib/refusals/read';
+
+/**
+ * The **Restraint tab** (CONTEXT.md, LOCKED): what RepWorth chose not to do in
+ * the selected window, and why.
+ *
+ * PURE PRESENTATION FED BY ONE `RefusalLog`, exactly as `BatchReport` is fed one
+ * `BatchView` (plan §4, §6 T7). That is the whole reason for the shape: the
+ * stated total and the per-category counts come from the SAME object, so they
+ * cannot disagree. **Never recompute the total here** — `groupEntries`
+ * (`src/lib/refusals/read.ts`) builds it as the sum of the group counts, and a
+ * second derivation in the view is a second answer waiting to drift.
+ *
+ * ORDERING BELONGS TO THE READ. `getRefusalLog` ends `ORDER BY occurred_at DESC,
+ * entry_id DESC` and `groupEntries` buckets in that order, so every group
+ * arrives newest first and every group is already in `REFUSAL_CATEGORIES`
+ * precedence order. This file maps; it does not sort.
+ *
+ * LINKS ONLY, NO WRITES (intake non-goal). Nothing here records a refusal,
+ * changes a gate, or posts anything.
+ *
+ * NO REASON TEXT, EVER. The read never selects `flagged_responses.reason` (S1 is
+ * deny-all RLS, invariant #4 — redaction is the whole security story, plan §7
+ * risk 1), so a row simply has no prose to render. Do not add a "details"
+ * affordance either: it would imply a stored reason the owner could reach, and
+ * for the highest-volume lane there is none (plan §2, "the gap this feature
+ * cannot close"). A row is a DATE and, when the vocabulary gives it one, a link.
+ */
+
+interface Props {
+  /** The one object. Both the total and every count are read from it. */
+  log: RefusalLog;
+  /** The window the log was fetched for — the phrase, not a second filter. */
+  period: DashboardWindow;
+}
+
+/**
+ * How each window READS in a sentence. Keyed `Record<DashboardWindow, …>` so a
+ * fifth window is a compile error rather than an unlabelled hero line. The
+ * words differ from `PeriodToolbar`'s button labels on purpose: those name a
+ * control, these complete a sentence.
+ */
+const WINDOW_PHRASE: Record<DashboardWindow, string> = {
+  '7d': 'the last 7 days',
+  '30d': 'the last 30 days',
+  '90d': 'the last 90 days',
+  '12w': 'the last 12 weeks',
+};
+
+/**
+ * The two fixed destinations the vocabulary names, and how each one reads.
+ *
+ * DERIVED FROM `REFUSAL_CATEGORY_META`, never re-listed. The key type is the
+ * union of hrefs the vocabulary actually carries, so adding, removing or
+ * re-pointing a category's link fails to compile HERE until the wording follows
+ * it. The vocabulary owns the destination; this table owns only the words.
+ */
+type CategoryLink = (typeof REFUSAL_CATEGORY_META)[RefusalCategory]['link'];
+type HrefDestination = Extract<CategoryLink, { kind: 'href' }>['href'];
+
+const DESTINATION_LABEL: Record<HrefDestination, string> = {
+  '/dashboard/requests/contacts': 'Who we may contact',
+  '/settings/auto-approval': 'Auto-approval settings',
+};
+
+/** The per-review destination. `/dashboard/reviews/<id>` has no page of its own
+ *  — the timeline IS the review page, and it is what `NeedsAttentionList` and
+ *  `ReviewFeedCard` already link to, so the owner lands somewhere familiar. */
+const REVIEW_LINK_LABEL = 'See the review';
+
+/**
+ * THE TWO LINK KINDS RENDER IN DIFFERENT PLACES, because the vocabulary says
+ * they are different things: "`href` is the same page for every entry, `review`
+ * is resolved per entry from the review that entry names"
+ * (`REFUSAL_CATEGORY_META`'s own contract). So an `href` belongs to the
+ * CATEGORY and is drawn once beside its sentence — repeating one destination on
+ * every row is five copies of one fact — while a `review` belongs to the ROW.
+ */
+interface SharedDestination {
+  href: string;
+  label: string;
+}
+
+/** The category's single fixed destination, or `null` for a category that
+ *  carries none and for the per-entry `review` kind, which {@link reviewHrefFor}
+ *  owns. Unconditional by construction: same page, every entry. */
+function sharedDestinationFor(
+  category: RefusalCategory,
+): SharedDestination | null {
+  const link = REFUSAL_CATEGORY_META[category].link;
+  return link !== null && link.kind === 'href'
+    ? { href: link.href, label: DESTINATION_LABEL[link.href] }
+    : null;
+}
+
+/**
+ * The review link, and the reason it takes an ENTRY rather than a category
+ * (T1's finding, deviation D8).
+ *
+ * `unsafe_content` is fed by TWO sources: S1 held drafts, which name a review,
+ * and S6 `moderation_high` outreach withholds, which do not. Category and
+ * source are not 1:1, so a link keyed off the category would render a dead
+ * `/dashboard/reviews/null/timeline` for half of one heading. The vocabulary
+ * marks the KIND; the ENTRY's own `reviewId` decides whether there is a link at
+ * all.
+ */
+function reviewHrefFor(entry: RefusalEntry): string | null {
+  const link = REFUSAL_CATEGORY_META[entry.category].link;
+  if (link === null || link.kind !== 'review') return null;
+  return entry.reviewId === null
+    ? null
+    : `/dashboard/reviews/${encodeURIComponent(entry.reviewId)}/timeline`;
+}
+
+export function RestraintReport({ log, period }: Props) {
+  const phrase = WINDOW_PHRASE[period];
+
+  return (
+    <>
+      <section
+        className="card rst-summary section-enter section-enter-1"
+        aria-labelledby="rst-summary-heading"
+      >
+        <h2 className="card-h2" id="rst-summary-heading">
+          What we held back
+        </h2>
+        {log.total === 0 ? (
+          // The empty window is a FACT, not an error and not an empty grid
+          // (CONTEXT.md → Restraint tab). One plain sentence, and no headings
+          // for categories that held nobody — `log.categories` is empty here by
+          // construction, so there is nothing to suppress.
+          <p className="rst-summary-empty">
+            We did not hold anything back in {phrase}. Everything we were asked
+            to do, we did.
+          </p>
+        ) : (
+          <>
+            <p className="rst-summary-line">
+              <span className="rst-summary-count">{log.total}</span>
+              <span className="rst-summary-cap">
+                {log.total === 1 ? 'thing' : 'things'} we chose not to do in{' '}
+                {phrase}
+              </span>
+            </p>
+            <p className="rst-summary-sub">
+              Grouped by what stopped us, newest first. None of it was sent.
+            </p>
+          </>
+        )}
+      </section>
+
+      {log.categories.map((group, index) => (
+        <CategorySection key={group.category} group={group} index={index} />
+      ))}
+    </>
+  );
+}
+
+/** One heading per category that actually held something, in the order the
+ *  read handed them over — `REFUSAL_CATEGORIES` precedence, safety first. */
+function CategorySection({
+  group,
+  index,
+}: {
+  group: RefusalCategoryGroup;
+  index: number;
+}) {
+  const meta = REFUSAL_CATEGORY_META[group.category];
+  const headingId = `rst-group-${group.category}`;
+  const shared = sharedDestinationFor(group.category);
+
+  return (
+    <section
+      className={`card rst-group section-enter ${enterStagger(index)}`}
+      aria-labelledby={headingId}
+    >
+      <div className="rst-group-head">
+        <h2 className="rst-group-title" id={headingId}>
+          {meta.label}
+        </h2>
+        <span className="rst-group-count">
+          {group.count} {group.count === 1 ? 'time' : 'times'}
+        </span>
+      </div>
+      {/* The owner's own sentence for this category, verbatim from the
+          vocabulary. Never a re-worded copy: the words are the contract. */}
+      <p className="rst-group-sentence">
+        {meta.sentence}
+        {shared !== null && (
+          <>
+            {' '}
+            <Link className="rst-group-link" href={shared.href}>
+              {shared.label}
+            </Link>
+          </>
+        )}
+      </p>
+      <ul className="rst-rows">
+        {group.entries.map((entry) => (
+          <EntryRow key={entry.id} entry={entry} />
+        ))}
+      </ul>
+    </section>
+  );
+}
+
+function EntryRow({ entry }: { entry: RefusalEntry }) {
+  const reviewHref = reviewHrefFor(entry);
+  const occurred = new Date(entry.occurredAt);
+
+  return (
+    <li className="rst-row">
+      <time className="rst-row-when" dateTime={entry.occurredAt}>
+        {DAY_FORMAT.format(occurred)}
+      </time>
+      <span className="rst-row-ago">{relativeDay(occurred)}</span>
+      {reviewHref !== null && (
+        <Link className="rst-row-link" href={reviewHref}>
+          {REVIEW_LINK_LABEL}
+        </Link>
+      )}
+    </li>
+  );
+}
+
+// ── Formatting ──────────────────────────────────────────────────────────────
+
+/** Module-scope formatters: building an `Intl` formatter per render is the
+ *  no-locale-format-in-render hotspot (`BatchReport.tsx` states the same rule).
+ *  UTC for the same reason it does — the stamp is a server instant, and a
+ *  viewer's zone must not slide a refusal onto a different day. */
+const DAY_FORMAT = new Intl.DateTimeFormat(undefined, {
+  year: 'numeric',
+  month: 'short',
+  day: 'numeric',
+  timeZone: 'UTC',
+});
+const RELATIVE_FORMAT = new Intl.RelativeTimeFormat(undefined, {
+  numeric: 'auto',
+});
+
+const HOUR_MS = 3_600_000;
+const DAY_MS = 86_400_000;
+
+/** "3 days ago" beside the date — derived from the timestamp alone, so it adds
+ *  a second reading of the same fact and no new information about the row. */
+function relativeDay(occurred: Date): string {
+  const elapsed = Date.now() - occurred.getTime();
+  if (elapsed < HOUR_MS) {
+    return RELATIVE_FORMAT.format(-Math.round(elapsed / 60_000), 'minute');
+  }
+  if (elapsed < DAY_MS) {
+    return RELATIVE_FORMAT.format(-Math.round(elapsed / HOUR_MS), 'hour');
+  }
+  return RELATIVE_FORMAT.format(-Math.round(elapsed / DAY_MS), 'day');
+}
+
+/** `.section-enter-1` is the summary card, so the groups start at 2 and hold at
+ *  the last defined step rather than emitting a class console.css never wrote. */
+function enterStagger(index: number): string {
+  return `section-enter-${Math.min(index + 2, 6)}`;
+}
