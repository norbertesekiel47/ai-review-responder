    46	export function RestraintContent() {
    47	  const { currentScope } = useLocationScope();
    48	  const [period, setPeriod] = useState<DashboardWindow>(DEFAULT_DASHBOARD_WINDOW);
    49	  const { data, error, loading } = useDashboardData(currentScope, { window: period });
    50	  const refusals = useRefusalLog(currentScope, period);
    51	
    52	  const periodToolbar = <PeriodToolbar value={period} onChange={setPeriod} />;
    53	
