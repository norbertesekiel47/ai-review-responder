    63	  }
    64	
    65	  // Invariant #11: entitlement is `perLocationActive`'s call, never a raw status
    66	  // comparison here. The aggregate payload carries no per-location subscription,
    67	  // so it passes through — as it does on every other dashboard read surface.
    68	  if (!isAggregate(data) && perLocationActive(data) === null) {
    69	    return (
