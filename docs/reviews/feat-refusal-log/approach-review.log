   413	/**
   414	 * Every refusal for one scope and one window, newest first.
   415	 *
   416	 * The window is `[now - windowDays, now]` and the START boundary is `>=`,
   417	 * matching `getAgentTeamSummary`: an entry stamped exactly at the boundary is
   418	 * inside the window. Both bounds are bound as parameters off ONE `now`, so
   419	 * every arm shares the same instant.
   420	 */
   421	export async function getRefusalLog(
   422	  sql: Sql,
   423	  scope: DashboardReadScope,
   424	  window: DashboardWindow,
   425	): Promise<RefusalLog> {
   426	  const { windowDays } = dashboardWindowParams(window);
   427	  const windowEnd = new Date();
   428	  const windowStart = new Date(
   429	    windowEnd.getTime() - windowDays * 24 * 60 * 60 * 1000,
   430	  );
   431	  const inLocation = locationFilter(sql, scope);
   432	
   433	  const rows = await sql<RefusalRow[]>`
   434	    SELECT entry_id, source, code, occurred_at, review_id
   435	    FROM (
   436	      -- S1 · Held draft: flagged_responses (deny-all RLS, invariant #4), keyed
   437	      -- account_id + business_id, anchored on created_at — the moment
   438	      -- moderation ruled and the send_notification enqueue was skipped.
   439	      --
   440	      -- NO code axis and NO moderation prose: the lane itself is the whole
   441	      -- fact, its category is the fixed HELD_DRAFT_REFUSAL_CATEGORY, and the
   442	      -- moderation text may never leave the server (intake invariant 4). This
   443	      -- table is read through the RLS-bypassing postgres role, so the two
   444	      -- predicates below plus the both-sides join ARE the access control.
   445	      SELECT
   446	        r.id::text AS entry_id,
   447	        ${HELD_DRAFT_SOURCE}::text AS source,
   448	        NULL::text AS code,
   449	        r.created_at AS occurred_at,
   450	        rev.id AS review_id
   451	      FROM flagged_responses r
   452	      INNER JOIN businesses loc
   453	              ON loc.id = r.business_id
   454	             AND loc.account_id = ${scope.accountId}
   455	      INNER JOIN reviews rev
   456	              ON rev.id = r.review_id
   457	             AND rev.business_id = loc.id
   458	      WHERE r.account_id = ${scope.accountId}
   459	        AND ${inLocation}
   460	        -- Plan §3: S1 feeds unsafe_content at HIGH severity. A lower-severity
   461	        -- admin flag is a note about a draft, not a draft we refused to send.
   462	        AND r.severity = 'high'
   463	        AND r.created_at >= ${windowStart}
   464	        AND r.created_at <= ${windowEnd}
   465	
   466	      UNION ALL
   467	
   468	      -- S3 · Auto-post revoked: approval_audit_log, keyed account_id +
   469	      -- business_id, anchored on created_at — the audit row IS the revocation.
   470	      --
   471	      -- The code axis is the stored AUDIT ACTION, not the downgrade reason, and
   472	      -- there are five of them because DOWNGRADE_MARKERS collapses the two
   473	      -- judge reasons onto one. One response downgraded twice yields two audit
   474	      -- rows and therefore two entries: each is a separate act of restraint.
   475	      SELECT
   476	        r.id::text AS entry_id,
   477	        ${AUTO_POST_REVOKED_SOURCE}::text AS source,
   478	        r.action::text AS code,
   479	        r.created_at AS occurred_at,
   480	        resp.review_id AS review_id
   481	      FROM approval_audit_log r
   482	      INNER JOIN businesses loc
   483	              ON loc.id = r.business_id
   484	             AND loc.account_id = ${scope.accountId}
   485	      INNER JOIN responses resp
   486	              ON resp.id = r.response_id
   487	             AND resp.business_id = loc.id
   488	      WHERE r.account_id = ${scope.accountId}
   489	        AND ${inLocation}
   490	        AND r.action = ANY(${AUTO_POST_REVOKED_ACTIONS}::text[])
   491	        AND r.created_at >= ${windowStart}
   492	        AND r.created_at <= ${windowEnd}
   493	
   494	      UNION ALL
   495	
   496	      -- S4 · Autonomy suspended: account_audit_log, event_type
   497	      -- 'autonomy_suspended', anchored on created_at. The code is the
   498	      -- AutonomySuspensionTrigger inside payload (suspension.ts:309-313).
   499	      --
   500	      -- SOURCED HERE ON PURPOSE. unsuspendAccountAutonomy sets
   501	      -- auto_approval_policies.suspended_at and .suspended_reason to NULL
   502	      -- (suspension.ts:352-354), so the policy row holds no history at all; the
   503	      -- audit row is the durable trace and a lifted suspension still appears.
   504	      --
   505	      -- ACCOUNT-WIDE, SO NO businesses JOIN AND NO location conjunct.
   506	      -- account_audit_log carries a nullable location_id the suspension writer
   507	      -- leaves NULL, and a suspended account default applies to every location
   508	      -- — so this arm belongs in every location scope. Joining it through
   509	      -- businesses to reach that effect would MULTIPLY one audit row by the
   510	      -- account's location count in aggregate scope; the eval pins exactly-once
   511	      -- in both scopes so a later "optimisation" cannot quietly add the join.
   512	      SELECT
   513	        r.id::text AS entry_id,
   514	        ${AUTONOMY_SUSPENDED_SOURCE}::text AS source,
   515	        r.payload->>'trigger' AS code,
   516	        r.created_at AS occurred_at,
   517	        NULL::uuid AS review_id
   518	      FROM account_audit_log r
   519	      WHERE r.account_id = ${scope.accountId}
   520	        AND r.event_type = ${AUTONOMY_SUSPENDED_EVENT_TYPE}
   521	        AND r.payload->>'trigger' = ANY(${AUTONOMY_SUSPENDED_TRIGGERS}::text[])
   522	        AND r.created_at >= ${windowStart}
   523	        AND r.created_at <= ${windowEnd}
   524	
   525	      UNION ALL
   526	
   527	      -- S5 · Ask withheld at build: solicitation_asks, the withhold arm, keyed
   528	      -- account_id + business_id, anchored on decided_at — the moment the
   529	      -- Restraint policy ruled, written once by the batch builder.
   530	      SELECT
   531	        r.id::text AS entry_id,
   532	        ${ASK_WITHHELD_SOURCE}::text AS source,
   533	        r.withheld_reason::text AS code,
   534	        r.decided_at AS occurred_at,
   535	        NULL::uuid AS review_id
   536	      FROM solicitation_asks r
   537	      WHERE r.account_id = ${scope.accountId}
   538	        AND ${inLocation}
   539	        AND r.status = 'withhold'
   540	        AND r.withheld_reason = ANY(${ASK_WITHHELD_CODES}::text[])
   541	        AND r.decided_at >= ${windowStart}
   542	        AND r.decided_at <= ${windowEnd}
   543	
   544	      UNION ALL
   545	
   546	      -- S6 · Outreach withheld at send: solicitation_outreach, keyed account_id
   547	      -- + business_id. THE WITHHELD ARM ONLY.
   548	      --
   549	      -- The cancelled arm is out of scope entirely, and that is a double-count
   550	      -- guard rather than a simplification: latchHalt writes a batch's halt
   551	      -- reason through to EVERY cancelled outreach row, so counting its
   552	      -- admin_halt/platform_halt copies would report one halt again per
   553	      -- recipient — S7 below already counts it once, at the batch.
   554	      --
   555	      -- THE ANCHOR IS REASON-DEPENDENT, because the withheld arm has TWO
   556	      -- writers and neither half's anchor is correct alone (plan §2 as
   557	      -- corrected by review round 3). ask-generation.ts INSERTs a row ALREADY
   558	      -- withheld at render time for the three RENDER_WITHHOLD_REASONS, where
   559	      -- rendered_at IS the refusal time (NOT NULL, never updated) and
   560	      -- agent_run_id points at the BATCH PARENT — whose started_at is the
   561	      -- batch's start, not this row's decision. dispatch.ts commitWithhold
   562	      -- (1371-1379) writes the other five and sets agent_run_id to a lazy CHILD
   563	      -- run in the same statement, and agent_runs.started_at (071:25) is
   564	      -- DEFAULT NOW() with no updater, so that stamp is durable. updated_at is
   565	      -- a general mutation timestamp a later write can move and survives ONLY
   566	      -- as the fallback for a dispatch-time withhold whose best-effort child
   567	      -- attach left agent_run_id NULL — an accepted residual drift (plan §2).
   568	      --
   569	      -- The anchor is computed ONCE in the LATERAL below and referenced by both
   570	      -- the projection and the window bounds, so the value the owner sees and
   571	      -- the value the window filters on cannot diverge.
   572	      SELECT
   573	        r.id::text AS entry_id,
   574	        ${OUTREACH_WITHHELD_SOURCE}::text AS source,
   575	        r.disposition_reason::text AS code,
   576	        anchor.occurred_at AS occurred_at,
   577	        NULL::uuid AS review_id
   578	      FROM solicitation_outreach r
   579	      INNER JOIN businesses loc
   580	              ON loc.id = r.business_id
   581	             AND loc.account_id = ${scope.accountId}
   582	      -- LEFT, not INNER: agent_run_id is nullable and its absence is the
   583	      -- updated_at fallback, not a reason to drop the refusal. Scoped on BOTH
   584	      -- tenant keys like every other join here — migration 091's composite FK
   585	      -- already prevents a cross-tenant match, but the every-join rule is not
   586	      -- conditioned on a constraint happening to exist.
   587	      LEFT JOIN agent_runs run
   588	             ON run.id = r.agent_run_id
   589	            AND run.account_id = ${scope.accountId}
   590	            AND run.business_id = loc.id
   591	      CROSS JOIN LATERAL (
   592	        SELECT CASE
   593	                 WHEN r.disposition_reason = ANY(${RENDER_WITHHOLD_CODES}::text[])
   594	                 THEN r.rendered_at
   595	                 ELSE COALESCE(run.started_at, r.updated_at)
   596	               END AS occurred_at
   597	      ) AS anchor
   598	      WHERE r.account_id = ${scope.accountId}
   599	        AND ${inLocation}
   600	        AND r.delivery_status = 'withheld'
   601	        AND r.disposition_reason = ANY(${OUTREACH_WITHHELD_CODES}::text[])
   602	        AND anchor.occurred_at >= ${windowStart}
   603	        AND anchor.occurred_at <= ${windowEnd}
   604	
   605	      UNION ALL
   606	
   607	      -- S7 · Batch halted by us: solicitation_batches, keyed account_id +
   608	      -- business_id, anchored on halted_at — 091's halt-consistency CHECK makes
   609	      -- halted_at and halt_reason a two-way pairing, so the stamp is present
   610	      -- exactly when the reason is.
   611	      --
   612	      -- TWO OF SIX REASONS. admin_halt and platform_halt are acts of OUR
   613	      -- restraint; owner_veto and owner_halt are the owner's own act, and
   614	      -- batch_expired and send_window_elapsed are clocks running out. All four
   615	      -- map to null in the vocabulary and never reach BATCH_HALTED_CODES.
   616	      --
   617	      -- No businesses bridge: solicitation_batches carries a COMPOSITE FK to
   618	      -- businesses (id, account_id) (088:129-131), so its business_id belongs
   619	      -- to its account_id by construction, and the arm names no child table.
   620	      SELECT
   621	        r.id::text AS entry_id,
   622	        ${BATCH_HALTED_SOURCE}::text AS source,
   623	        r.halt_reason::text AS code,
   624	        r.halted_at AS occurred_at,
   625	        NULL::uuid AS review_id
   626	      FROM solicitation_batches r
   627	      WHERE r.account_id = ${scope.accountId}
   628	        AND ${inLocation}
   629	        AND r.halt_reason = ANY(${BATCH_HALTED_CODES}::text[])
   630	        AND r.halted_at >= ${windowStart}
   631	        AND r.halted_at <= ${windowEnd}
   632	    ) AS refusal_entries
   633	    ORDER BY occurred_at DESC, entry_id DESC
   634	  `;
   635	
   636	  return groupEntries(rows);
   637	}
   115	/**
   116	 * The review link, and the reason it takes an ENTRY rather than a category
   117	 * (T1's finding, deviation D8).
   118	 *
   119	 * `unsafe_content` is fed by TWO sources: S1 held drafts, which name a review,
   120	 * and S6 `moderation_high` outreach withholds, which do not. Category and
   121	 * source are not 1:1, so a link keyed off the category would render a dead
   122	 * `/dashboard/reviews/null/timeline` for half of one heading. The vocabulary
   123	 * marks the KIND; the ENTRY's own `reviewId` decides whether there is a link at
   124	 * all.
   125	 */
   126	function reviewHrefFor(entry: RefusalEntry): string | null {
   127	  const link = REFUSAL_CATEGORY_META[entry.category].link;
   128	  if (link === null || link.kind !== 'review') return null;
   129	  return entry.reviewId === null
   130	    ? null
   131	    : `/dashboard/reviews/${encodeURIComponent(entry.reviewId)}/timeline`;
   132	}
   133	
   134	export function RestraintReport({ log, period }: Props) {
   135	  const phrase = WINDOW_PHRASE[period];
   136	
   137	  return (
