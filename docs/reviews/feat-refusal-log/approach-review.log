        WHERE account_offboarding_id = ${offboardingId}::uuid
      `;

    case 'contact_csv_uploads':
      return exec<VerificationRow[]>`
        SELECT COUNT(*) AS violation_count
        FROM contact_csv_uploads
        WHERE account_id = ${accountId}::uuid
      `;
    case 'solicitation_contacts':
      return absentByBusiness('solicitation_contacts', accountId, exec);
    case 'solicitation_visits':
      return absentByBusiness('solicitation_visits', accountId, exec);
    case 'solicitation_batches':
      return exec<VerificationRow[]>`
        SELECT COUNT(*) AS violation_count
        FROM solicitation_batches
        WHERE account_id = ${accountId}::uuid
      `;
    case 'solicitation_asks':
      return exec<VerificationRow[]>`
        SELECT COUNT(*) AS violation_count
        FROM solicitation_asks
        WHERE account_id = ${accountId}::uuid
      `;
    // Outreach has no DELETE of its own (G9): it cascades from
    // solicitation_batches, which cascades from contact_csv_uploads. This is
    // the read-side proof that the cascade actually fired.
    case 'solicitation_outreach':
      return exec<VerificationRow[]>`
        SELECT COUNT(*) AS violation_count
        FROM solicitation_outreach
        WHERE account_id = ${accountId}::uuid
      `;

    // The consent ledger carries NO account_id by design (#625 spec §3.2), so
    // verification joins through businesses like the contacts/visits it covers.
    // businesses are retain_deidentified (tombstoned, never DELETEd), so the
    // businesses(id) ON DELETE CASCADE never fires during offboarding purge —
    // this is the read-side proof of purge-stages.ts's explicit
    // deleteByBusiness('solicitation_consent') sweep, the ONLY deleter here.
    case 'solicitation_consent':
      return absentByBusiness('solicitation_consent', accountId, exec);

    // SCOPE NOTE (G13): this verifier counts VIOLATIONS, so it structurally
    // cannot prove RETENTION — "correctly retained" and "every row wrongly
    // deleted" both return 0. The retention guarantee for the Suppression
    // ledger is therefore a TEST obligation, never a runtime check.
    //
    // TWO branches, both of which CAN fire:
    // (a) a surviving account-scoped row — the account's own data, must be gone;
    // (b) a retained global row still naming one of this account's users.
    //
    // Branch (b) is vacuous for VALID data — admin users carry
        AND b.account_id = ${row.account_id}::uuid
    `;
  });
}

export async function runAuditAndCostPayloadPurgeStage(sql: postgres.Sql, row: AccountOffboardingPurgeRow): Promise<void> {
  await sql.begin(async (tx) => {
    const impersonationSessionIds = await scopedImpersonationSessionIds(tx, row);
    await tx`
      UPDATE account_audit_log
      SET location_id = NULL,
          actor_user_id = NULL,
          payload = '{}'::jsonb,
          entity_id = NULL,
          ip = NULL,
          user_agent = NULL,
          request_id = NULL
      WHERE account_id = ${row.account_id}::uuid
    `;
    if (impersonationSessionIds.length > 0) {
      await tx`
        UPDATE account_offboardings
        SET provider_dispositions = provider_dispositions || ${tx.json(impersonationSessionIds.map(impersonationSessionScrubScopeRecord) as never)},
            updated_at = NOW()
        WHERE id = ${row.id}::uuid
          AND account_id = ${row.account_id}::uuid
          AND terminal_at IS NULL
      `;
      await tx`
        UPDATE impersonation_sessions
        SET ticket_id = 'scrubbed:' || id::text,
            reason = 'account purged',
            account_id = NULL,
            impersonated_user_id = NULL,
            ended_at = COALESCE(ended_at, NOW())
        WHERE id = ANY(${impersonationSessionIds}::uuid[])
      `;
    }
  });
}


