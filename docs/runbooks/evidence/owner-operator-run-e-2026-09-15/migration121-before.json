  "constraintsQuery": "SELECT conname, pg_get_constraintdef(oid) AS definition, convalidated FROM pg_constraint WHERE conrelid='public.refusal_events'::regclass ORDER BY conname;",
  "securityQuery": "SELECT c.relrowsecurity AS rls_enabled,c.relforcerowsecurity AS rls_forced,\ncoalesce((SELECT jsonb_agg(jsonb_build_object('name',p.policyname,'roles',p.roles,'cmd',p.cmd,'qual',p.qual,'with_check',p.with_check) ORDER BY p.policyname) FROM pg_policies p WHERE p.schemaname='public' AND p.tablename='refusal_events'),'[]'::jsonb) AS policies,\ncoalesce((SELECT jsonb_agg(jsonb_build_object('grantee',CASE WHEN a.grantee=0 THEN 'PUBLIC' ELSE pg_get_userbyid(a.grantee) END,'grantor',pg_get_userbyid(a.grantor),'privilege',a.privilege_type,'grantable',a.is_grantable) ORDER BY a.grantee,a.privilege_type) FROM aclexplode(coalesce(c.relacl,acldefault('r',c.relowner))) a),'[]'::jsonb) AS privileges,\ncoalesce((SELECT jsonb_agg(jsonb_build_object('name',indexname,'definition',indexdef) ORDER BY indexname) FROM pg_indexes WHERE schemaname='public' AND tablename='refusal_events'),'[]'::jsonb) AS indexes\nFROM pg_class c WHERE c.oid='public.refusal_events'::regclass;",
  "staging": {
    "project": "kubdiqdhqbhwmqfditeg",
    "constraints": [
      {
        "conname": "refusal_events_account_id_fkey",
        "definition": "FOREIGN KEY (account_id) REFERENCES accounts(id)",
        "convalidated": true
      },
      {
        "conname": "refusal_events_all_codes_pairing",
        "definition": "CHECK (((((refusal_source = 'policy_gate_held'::text) AND (all_refusal_codes IS NOT NULL) AND (cardinality(all_refusal_codes) > 0) AND (array_position(all_refusal_codes, NULL::text) IS NULL) AND (refusal_code = ANY (all_refusal_codes))) OR ((refusal_source <> 'policy_gate_held'::text) AND (all_refusal_codes IS NULL))) IS TRUE))",
        "convalidated": true
      },
      {
        "conname": "refusal_events_business_id_fkey",
        "definition": "FOREIGN KEY (business_id) REFERENCES businesses(id)",
        "convalidated": true
      },
      {
        "conname": "refusal_events_business_pairing",
        "definition": "CHECK (((business_id IS NOT NULL) = (refusal_source <> 'autonomy_suspended'::text)))",
        "convalidated": true
      },
      {
        "conname": "refusal_events_code_pairing",
        "definition": "CHECK (((refusal_code IS NULL) = (refusal_source = 'held_draft'::text)))",
        "convalidated": true
      },
      {
        "conname": "refusal_events_pkey",
        "definition": "PRIMARY KEY (id)",
        "convalidated": true
      },
      {
        "conname": "refusal_events_refusal_category_check",
        "definition": "CHECK ((refusal_category = ANY (ARRAY['unsafe_content'::text, 'watchdog_unavailable'::text, 'below_our_bar'::text, 'no_permission'::text, 'wrong_moment'::text, 'autonomy_paused'::text, 'missing_information'::text, 'owner_review_required'::text])))",
        "convalidated": true
      },
      {
        "conname": "refusal_events_refusal_source_check",
        "definition": "CHECK ((refusal_source = ANY (ARRAY['held_draft'::text, 'auto_post_revoked'::text, 'autonomy_suspended'::text, 'ask_withheld'::text, 'outreach_withheld'::text, 'batch_halted'::text, 'policy_gate_held'::text])))",
        "convalidated": true
      },
      {
        "conname": "refusal_events_source_subject_pairing",
        "definition": "CHECK ((\nCASE refusal_source\n    WHEN 'held_draft'::text THEN (subject_type = 'response'::text)\n    WHEN 'policy_gate_held'::text THEN (subject_type = 'response'::text)\n    WHEN 'auto_post_revoked'::text THEN (subject_type = 'response'::text)\n    WHEN 'ask_withheld'::text THEN (subject_type = 'solicitation_ask'::text)\n    WHEN 'outreach_withheld'::text THEN (subject_type = 'solicitation_outreach'::text)\n    WHEN 'batch_halted'::text THEN (subject_type = 'solicitation_batch'::text)\n    WHEN 'autonomy_suspended'::text THEN (subject_type IS NULL)\n    ELSE NULL::boolean\nEND IS TRUE))",
        "convalidated": true
      },
      {
        "conname": "refusal_events_subject_completeness",
        "definition": "CHECK (((subject_type IS NULL) = (subject_id IS NULL)))",
        "convalidated": true
      },
      {
        "conname": "refusal_events_subject_type_check",
        "definition": "CHECK ((subject_type = ANY (ARRAY['response'::text, 'solicitation_ask'::text, 'solicitation_outreach'::text, 'solicitation_batch'::text])))",
        "convalidated": true
      }
