      "source": "(val) => {\n      try {\n        const url = new URL(val);\n        return url.protocol === 'http:' || url.protocol === 'https:';\n      } catch {\n        return false;\n      }\n    }"
    },
    {
      "kind": "refinement",
      "path": "$",
