{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "keyword": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "rankPosition": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": [
    "keyword",
    "rankPosition"
  ],
  "x-repworth-source": "src/app/api/admin/businesses/[id]/ranking/route.ts:14:23",
  "x-repworth-approximation": true,
  "x-repworth-limitations": [
    {
      "kind": "normalization",
      "path": "$.keyword",
      "operation": "trim",
      "source": "z.string().trim()"
    }
  ]
}
