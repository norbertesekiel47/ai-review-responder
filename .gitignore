# Local-only design handoff archives (Claude Design exports)
.tmp-design/

test-results/
playwright-report/
*.err.log
*.out.log
error.png
screenshot.png

# Chrome DevTools MCP per-session debug snapshots (console logs, page yamls,
# screenshots). Never useful in source control.
.playwright-mcp/

# git worktrees (isolated workspaces for parallel feature work)
.worktrees/
.claude/worktrees/

# Supabase CLI local artifacts (link state / temp files — per-machine, not shared)
supabase/.temp/

# Local tooling cache (not for commit)
.fallow/

# Local debug artifacts (Zernio connect flow diagnostic log)
zernio-debug.log

# Stray 0-byte artifact from a staging drill; cursor persistence is the
# poller_cursors TABLE (migration 081), never a local file.
poller_cursors.cursor

# local-only tooling and scratch artifacts
.claude-octopus/
.graphify_query.py
graphify-out/
scripts/zernio-count-reviews.ts

# Claude Code transient lock
.claude/scheduled_tasks.lock

# Temp scratch scripts (investigation/debug artifacts)
.tmp-*.cjs

# Literal "-w" file (accidental git add of vim swap-like artifact)
\-w

# Factory/Droid tooling artifacts (skills, missions, evidence — not source-controlled)
.factory/

# Lock-managed vendored skill: a local symlink into gitignored .agents/.
# Source of truth is skills-lock.json (committed); re-materialized on skills install.
.claude/skills/supabase-postgres-best-practices

# LLM eval run artifacts (keep the dir via .gitkeep)
tests/llm-eval/reports/*
!tests/llm-eval/reports/.gitkeep

# Local pnpm store (store-dir target; never source-controlled)
.pnpm-store/
# LLM eval run artifacts (PR4 harness; reports are not committed)
tests/llm-eval/reports/

# understand-anything knowledge graph (local analysis artifacts)
.understand-anything/

# Sentry Config File
.env.sentry-build-plugin

# impeccable design-hook local output (re-materialized by the hook)
.impeccable/

# /feature workflow run scratch — ephemeral, never committed. Living only on
# disk keeps the enforcement hooks (which arm off .feature/intake.json) from
# following a merged feature onto main and arming every future main session.
.feature/

# Session scratch — throwaway drivers/notes from live ops sessions (e.g. the
# Phase D suspension drill script). Never useful to future clones.
.scratch/

# Generated-artifact output from external tooling (spreadsheets, previews).
# NOT repo source and never committed, but it sits in the repo root, so an
# unignored copy is scanned by `fallow audit --gate new-only` and fails
# `ci:fallow:coverage` LOCALLY with findings that CI (a clean checkout) never
# sees — a confusing red gate on a clean branch. Ignored, not deleted: the
# contents are real work product.
outputs/
