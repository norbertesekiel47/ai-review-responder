# dependencies
/node_modules

# pnpm local content-addressable store (never committed)
.pnpm-store/

# binaries
stripe.exe
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sentry
.sentryclirc

# editor
.vscode/
.idea/

# docs/ is tracked by default (private repo — specs, runbooks, ADRs, agent
# docs are shared with the team). Ignore only generated/binary noise:
docs/graphify-out/
docs/superpowers/landingPageScreenshots/
docs/**/*.docx
docs/**/*.zip
.superpowers

# firecrawl scrape output (market research, not code)
.firecrawl/

# Claude Code per-machine settings (permissions, custom hooks). Contains
# user-specific allow lists — never shared across teammates. The rest of
# .claude/ (CLAUDE.md and skills/) IS tracked.
.claude/settings.local.json

# claude-mem per-machine cross-session memory (populated locally, not shared)
.agents/

# Local-only design handoff archives (Claude Design exports)
.tmp-design/

test-results/
playwright-report/
*.err.log
*.out.log
error.png
screenshot.png

# Chrome DevTools MCP per-session debug snapshots (console logs, page yamls,
# screenshots). Never useful in source control.
.playwright-mcp/

# git worktrees (isolated workspaces for parallel feature work)
.worktrees/
.claude/worktrees/

# Supabase CLI local artifacts (link state / temp files — per-machine, not shared)
supabase/.temp/

# Local tooling cache (not for commit)
.fallow/

# Local debug artifacts (Zernio connect flow diagnostic log)
zernio-debug.log

# local-only tooling and scratch artifacts
.claude-octopus/
.graphify_query.py
AGENTS.md
graphify-out/
scripts/zernio-count-reviews.ts

# Claude Code transient lock
.claude/scheduled_tasks.lock

# Temp scratch scripts (investigation/debug artifacts)
.tmp-*.cjs

# Literal "-w" file (accidental git add of vim swap-like artifact)
\-w

# Mission runtime artifacts (evidence, scripts — not for source control)
.factory/missions/

# LLM eval run artifacts (keep the dir via .gitkeep)
tests/llm-eval/reports/*
!tests/llm-eval/reports/.gitkeep

# Local pnpm store (store-dir target; never source-controlled)
.pnpm-store/
# LLM eval run artifacts (PR4 harness; reports are not committed)
tests/llm-eval/reports/
